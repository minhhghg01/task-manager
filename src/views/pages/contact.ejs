                                    <i data-feather="heart" class="text-danger" style="fill: currentColor; width: 18px; height: 18px;"></i>
                                    <%= settings.donateTitle %>
                                </h6>
                                <p class="text-muted small mb-3"><%= settings.donateMessage %></p>
                                <div class="d-inline-block p-2 bg-white rounded-3 shadow-sm border mb-2">
                                    <img src="/uploads/donate_qr.png" alt="Donate QR" class="img-fluid rounded" style="max-width: 220px; height: auto; display: block;">
                                </div>
                                <div class="text-center mt-1">
                                    <span class="badge bg-secondary-subtle text-secondary small">PVcomBank • 1080 0327 8371 • NGUYEN DUC MINH</span>
                                </div>
                            </div>
