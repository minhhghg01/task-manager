<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quên mật khẩu - Quản Lý Công Việc</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/custom.css?v=1.0.4" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .forgot-card {
            max-width: 460px;
            width: 100%;
            margin: auto;
        }
        .otp-input-box {
            letter-spacing: 8px;
            font-size: 24px;
            text-align: center;
        }
    </style>
</head>
<body class="login-bg d-flex align-items-center justify-content-center min-vh-100 py-4">
    <div class="login-card-new forgot-card text-start">
        <div class="text-center mb-4">
            <div class="mb-3 d-inline-block p-3 rounded-circle shadow-sm" style="background: rgba(79, 70, 229, 0.1);">
                <i data-feather="key" class="text-primary" style="width: 32px; height: 32px; stroke-width: 2.5px;"></i>
            </div>
            <h3 class="fw-bold text-primary">Khôi Phục Mật Khẩu</h3>
            <p class="text-muted small">Nhận mã xác thực qua Gmail và đặt lại mật khẩu</p>
        </div>

        <!-- BƯỚC 1: NHẬP TÀI KHOẢN -->
        <div id="step1">
            <div class="mb-3">
                <label class="form-label fw-semibold small text-muted">Tài khoản đăng nhập (Username)</label>
                <input type="text" id="usernameInput" class="form-control py-2.5" placeholder="Nhập tên tài khoản của bạn..." required>
                <div class="form-text text-muted small mt-1">Mã xác thực OTP sẽ được gửi về Gmail đã đăng ký trong hệ thống.</div>
            </div>
            <button type="button" id="btnSendOTP" class="btn btn-primary w-100 py-2.5 fw-bold shadow-sm">Gửi mã OTP</button>
            <div class="text-center mt-3">
                <a href="/login" class="small text-decoration-none fw-semibold text-muted">Quay lại Đăng nhập</a>
            </div>
        </div>

        <!-- BƯỚC 2: XÁC THỰC OTP -->
        <div id="step2" style="display: none;">
            <div class="alert alert-info py-2.5 small border-0 bg-primary bg-opacity-10 text-primary mb-3">
                Mã OTP đã được gửi đến email đăng ký: <strong id="maskedEmail">...</strong>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold small text-muted">Nhập mã OTP (6 chữ số)</label>
                <input type="text" id="otpInput" class="form-control otp-input-box font-monospace fw-bold py-2" placeholder="------" maxlength="6" required>
                <div class="d-flex justify-content-between align-items-center mt-2.5 small">
                    <span class="text-muted">Hết hạn sau: <strong id="timer" class="text-danger">03:00</strong></span>
                    <button type="button" id="btnResendOTP" class="btn btn-link p-0 text-decoration-none fw-semibold text-primary" style="font-size: 0.85rem;" disabled>Gửi lại mã</button>
                </div>
            </div>
            <button type="button" id="btnVerifyOTP" class="btn btn-primary w-100 py-2.5 fw-bold shadow-sm">Xác nhận mã OTP</button>
            <div class="text-center mt-3">
                <button type="button" id="btnBackToStep1" class="btn btn-link p-0 small text-decoration-none fw-semibold text-muted" style="font-size: 0.85rem;">Quay lại bước trước</button>
            </div>
        </div>

        <!-- BƯỚC 3: ĐẶT LẠI MẬT KHẨU (PREMIUM PASSWORD UI) -->
        <div id="step3" style="display: none;">
            <div class="alert alert-success py-2.5 small border-0 bg-success bg-opacity-10 text-success mb-3">
                Xác thực OTP thành công. Vui lòng thiết lập mật khẩu mới.
            </div>

            <!-- Mật khẩu mới -->
            <div class="premium-input-group">
                <input type="password" id="newPassword" name="newPassword" required autocomplete="new-password">
                <label for="newPassword">Mật khẩu mới</label>
                <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility('newPassword', this)">
                    <svg class="eye-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                </button>
            </div>

            <!-- Password Strength Meter -->
            <div class="strength-meter-container mb-3 px-1">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">Độ bảo mật</span>
                    <span class="small fw-bold text-muted" id="strengthLabel">Chưa nhập</span>
                </div>
                <div class="progress" style="height: 6px; background-color: var(--border-color); border-radius: 4px; overflow: hidden;">
                    <div id="strengthProgressBar" class="progress-bar bg-secondary" role="progressbar" style="width: 0%; transition: width 0.3s ease, background-color 0.3s ease;"></div>
                </div>
            </div>

            <!-- Checklist Criteria -->
            <div class="criteria-checklist mb-4 px-1">
                <div class="row g-2">
                    <div class="col-6">
                        <div class="criterion-item d-flex align-items-center gap-1 text-muted" id="crit-length">
                            <svg class="status-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle></svg>
                            <span class="small">Tối thiểu 8 ký tự</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="criterion-item d-flex align-items-center gap-1 text-muted" id="crit-upper">
                            <svg class="status-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle></svg>
                            <span class="small">Chữ in hoa (A-Z)</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="criterion-item d-flex align-items-center gap-1 text-muted" id="crit-lower">
                            <svg class="status-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle></svg>
                            <span class="small">Chữ thường (a-z)</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="criterion-item d-flex align-items-center gap-1 text-muted" id="crit-number">
                            <svg class="status-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle></svg>
                            <span class="small">Chữ số (123)</span>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="criterion-item d-flex align-items-center gap-1 text-muted" id="crit-special">
                            <svg class="status-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle></svg>
                            <span class="small">Ký tự đặc biệt (@#$)</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Nhập lại mật khẩu mới -->
            <div class="premium-input-group mb-4">
                <input type="password" id="confirmPassword" name="confirmPassword" required autocomplete="new-password">
                <label for="confirmPassword">Nhập lại mật khẩu mới</label>
                <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility('confirmPassword', this)">
                    <svg class="eye-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                </button>
            </div>

            <button type="button" id="btnResetPassword" class="btn btn-primary w-100 py-2.5 fw-bold shadow-sm" disabled>Cập nhật mật khẩu mới</button>
        </div>
    </div>

    <script src="https://unpkg.com/feather-icons"></script>
    <script>
        // Set Theme
        const theme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-bs-theme', theme);

        // Render Icons
        feather.replace();

        // Variables
        let username = '';
        let timerInterval = null;
        let resendCooldownSeconds = 0;
        let resendInterval = null;

        // Elements
        const step1 = document.getElementById('step1');
        const step2 = document.getElementById('step2');
        const step3 = document.getElementById('step3');
        const usernameInput = document.getElementById('usernameInput');
        const btnSendOTP = document.getElementById('btnSendOTP');
        const maskedEmail = document.getElementById('maskedEmail');
        const otpInput = document.getElementById('otpInput');
        const btnVerifyOTP = document.getElementById('btnVerifyOTP');
        const timerLabel = document.getElementById('timer');
        const btnResendOTP = document.getElementById('btnResendOTP');
        const btnBackToStep1 = document.getElementById('btnBackToStep1');
        const newPasswordInput = document.getElementById('newPassword');
        const confirmPasswordInput = document.getElementById('confirmPassword');
        const btnResetPassword = document.getElementById('btnResetPassword');
        const strengthLabel = document.getElementById('strengthLabel');
        const strengthProgressBar = document.getElementById('strengthProgressBar');

        // Eye Toggle function
        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            const type = input.getAttribute('type') === 'password' ? 'text' : 'password';
            input.setAttribute('type', type);
            
            if (type === 'text') {
                btn.innerHTML = `<svg class="eye-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>`;
            } else {
                btn.innerHTML = `<svg class="eye-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>`;
            }
        }

        // BƯỚC 1: GỬI OTP
        btnSendOTP.addEventListener('click', async () => {
            const val = usernameInput.value.trim();
            if (!val) {
                Swal.fire({ icon: 'warning', title: 'Thông báo', text: 'Vui lòng nhập tên tài khoản!' });
                return;
            }
            btnSendOTP.disabled = true;
            btnSendOTP.innerText = 'Đang xử lý...';

            try {
                const res = await fetch('/forgot-password/send-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username: val })
                });
                const data = await res.json();
                if (data.success) {
                    username = val;
                    maskedEmail.innerText = data.maskedEmail;
                    
                    // Chuyển sang bước 2
                    step1.style.display = 'none';
                    step2.style.display = 'block';

                    // Bắt đầu đếm ngược hạn OTP (3 phút)
                    startOTPTimer(180);

                    // Bắt đầu đếm ngược thời gian chờ để gửi lại mã (chống spam)
                    startResendCooldown(data.cooldown);

                    Swal.fire({ icon: 'success', title: 'Thành công', text: 'Mã xác thực OTP đã được gửi đến email đăng ký của bạn.', timer: 2000, showConfirmButton: false });
                } else {
                    Swal.fire({ icon: 'error', title: 'Lỗi', text: data.message });
                }
            } catch (err) {
                console.error(err);
                Swal.fire({ icon: 'error', title: 'Lỗi kết nối', text: 'Đã xảy ra lỗi, vui lòng thử lại sau.' });
            } finally {
                btnSendOTP.disabled = false;
                btnSendOTP.innerText = 'Gửi mã OTP';
            }
        });

        // BƯỚC 2: XÁC NHẬN OTP
        btnVerifyOTP.addEventListener('click', async () => {
            const code = otpInput.value.trim();
            if (code.length !== 6) {
                Swal.fire({ icon: 'warning', title: 'Thông báo', text: 'Mã OTP phải có độ dài đúng 6 ký tự số!' });
                return;
            }
            btnVerifyOTP.disabled = true;
            btnVerifyOTP.innerText = 'Đang xác minh...';

            try {
                const res = await fetch('/forgot-password/verify-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, otp: code })
                });
                const data = await res.json();
                if (data.success) {
                    clearInterval(timerInterval);
                    clearInterval(resendInterval);
                    
                    // Chuyển sang bước 3
                    step2.style.display = 'none';
                    step3.style.display = 'block';
                } else {
                    Swal.fire({ icon: 'error', title: 'Xác minh thất bại', text: data.message });
                }
            } catch (err) {
                console.error(err);
                Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Không thể xác thực mã OTP.' });
            } finally {
                btnVerifyOTP.disabled = false;
                btnVerifyOTP.innerText = 'Xác nhận mã OTP';
            }
        });

        // NÚT QUAY LẠI BƯỚC 1
        btnBackToStep1.addEventListener('click', () => {
            clearInterval(timerInterval);
            clearInterval(resendInterval);
            step2.style.display = 'none';
            step1.style.display = 'block';
        });

        // GỬI LẠI OTP
        btnResendOTP.addEventListener('click', async () => {
            if (resendCooldownSeconds > 0) return;
            btnResendOTP.disabled = true;
            
            try {
                const res = await fetch('/forgot-password/send-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username })
                });
                const data = await res.json();
                if (data.success) {
                    // Reset timer 3 phút
                    startOTPTimer(180);
                    // Reset cooldown gửi lại
                    startResendCooldown(data.cooldown);
                    Swal.fire({ icon: 'success', title: 'Thành công', text: 'Đã gửi lại mã OTP mới.', timer: 1500, showConfirmButton: false });
                } else {
                    Swal.fire({ icon: 'error', title: 'Lỗi', text: data.message });
                    // Nếu lỗi do cooldown chưa hết, cập nhật lại cooldown
                    if (data.cooldown) {
                        startResendCooldown(data.cooldown);
                    }
                }
            } catch (err) {
                console.error(err);
                Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Không thể gửi lại mã OTP.' });
                btnResendOTP.disabled = false;
            }
        });

        // Hàm chạy đồng hồ đếm ngược 3 phút hết hạn OTP
        function startOTPTimer(durationSeconds) {
            clearInterval(timerInterval);
            let timeRemaining = durationSeconds;
            
            function updateLabel() {
                const mins = Math.floor(timeRemaining / 60);
                const secs = timeRemaining % 60;
                timerLabel.innerText = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
            }
            
            updateLabel();
            timerInterval = setInterval(() => {
                timeRemaining--;
                updateLabel();
                if (timeRemaining <= 0) {
                    clearInterval(timerInterval);
                    Swal.fire({ icon: 'warning', title: 'Hết hạn', text: 'Mã OTP của bạn đã hết hiệu lực. Vui lòng bấm gửi lại mã.' });
                }
            }, 1000);
        }

        // Hàm chạy đếm ngược thời gian cooldown gửi lại mã OTP
        function startResendCooldown(seconds) {
            clearInterval(resendInterval);
            resendCooldownSeconds = seconds;
            
            function updateButton() {
                if (resendCooldownSeconds > 0) {
                    btnResendOTP.disabled = true;
                    if (resendCooldownSeconds >= 60) {
                        const mins = Math.ceil(resendCooldownSeconds / 60);
                        btnResendOTP.innerText = `Gửi lại (${mins}p)`;
                    } else {
                        btnResendOTP.innerText = `Gửi lại (${resendCooldownSeconds}s)`;
                    }
                } else {
                    btnResendOTP.disabled = false;
                    btnResendOTP.innerText = 'Gửi lại mã';
                }
            }

            updateButton();
            resendInterval = setInterval(() => {
                resendCooldownSeconds--;
                updateButton();
                if (resendCooldownSeconds <= 0) {
                    clearInterval(resendInterval);
                }
            }, 1000);
        }

        // PREMIUM PASSWORD VALIDATION
        const criteria = {
            length: {
                element: document.getElementById('crit-length'),
                regex: /^.{8,}$/
            },
            upper: {
                element: document.getElementById('crit-upper'),
                regex: /[A-Z]/
            },
            lower: {
                element: document.getElementById('crit-lower'),
                regex: /[a-z]/
            },
            number: {
                element: document.getElementById('crit-number'),
                regex: /[0-9]/
            },
            special: {
                element: document.getElementById('crit-special'),
                regex: /[^A-Za-z0-9]/
            }
        };

        const metSvg = `<svg class="status-icon text-success" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>`;
        const unmetSvg = `<svg class="status-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle></svg>`;

        function validatePassword() {
            const val = newPasswordInput.value;
            let score = 0;

            for (const key in criteria) {
                const criterion = criteria[key];
                const isValid = criterion.regex.test(val);
                const iconSvg = criterion.element.querySelector('.status-icon');

                if (isValid) {
                    criterion.element.classList.add('valid');
                    criterion.element.classList.remove('text-muted');
                    if (iconSvg) iconSvg.outerHTML = metSvg;
                    score++;
                } else {
                    criterion.element.classList.remove('valid');
                    criterion.element.classList.add('text-muted');
                    if (iconSvg) iconSvg.outerHTML = unmetSvg;
                }
            }

            const newPasswordGroup = newPasswordInput.closest('.premium-input-group');
            if (val.length === 0) {
                strengthLabel.innerText = "Chưa nhập";
                strengthLabel.className = "small fw-bold text-muted";
                strengthProgressBar.style.width = "0%";
                strengthProgressBar.className = "progress-bar bg-secondary";
                if (newPasswordGroup) {
                    newPasswordGroup.classList.remove('is-valid-state', 'is-invalid-state');
                }
            } else if (score <= 2) {
                strengthLabel.innerText = "Yếu";
                strengthLabel.className = "small fw-bold text-danger";
                strengthProgressBar.style.width = "33%";
                strengthProgressBar.className = "progress-bar bg-danger";
                if (newPasswordGroup) {
                    newPasswordGroup.classList.add('is-invalid-state');
                    newPasswordGroup.classList.remove('is-valid-state');
                }
            } else if (score < 5) {
                strengthLabel.innerText = "Trung bình";
                strengthLabel.className = "small fw-bold text-warning";
                strengthProgressBar.style.width = "66%";
                strengthProgressBar.className = "progress-bar bg-warning";
                if (newPasswordGroup) {
                    newPasswordGroup.classList.add('is-invalid-state');
                    newPasswordGroup.classList.remove('is-valid-state');
                }
            } else {
                strengthLabel.innerText = "Mạnh";
                strengthLabel.className = "small fw-bold text-success";
                strengthProgressBar.style.width = "100%";
                strengthProgressBar.className = "progress-bar bg-success";
                if (newPasswordGroup) {
                    newPasswordGroup.classList.add('is-valid-state');
                    newPasswordGroup.classList.remove('is-invalid-state');
                }
            }

            checkFormValidity(score);
        }

        function checkFormValidity(score) {
            const passVal = newPasswordInput.value;
            const confirmVal = confirmPasswordInput.value;

            const passwordsMatch = passVal === confirmVal && passVal.length > 0;
            const isStrongEnough = score === 5;

            const confirmPasswordGroup = confirmPasswordInput.closest('.premium-input-group');
            if (confirmVal.length === 0) {
                if (confirmPasswordGroup) confirmPasswordGroup.classList.remove('is-valid-state', 'is-invalid-state');
            } else if (passwordsMatch) {
                if (confirmPasswordGroup) {
                    confirmPasswordGroup.classList.add('is-valid-state');
                    confirmPasswordGroup.classList.remove('is-invalid-state');
                }
            } else {
                if (confirmPasswordGroup) {
                    confirmPasswordGroup.classList.add('is-invalid-state');
                    confirmPasswordGroup.classList.remove('is-valid-state');
                }
            }

            if (isStrongEnough && passwordsMatch) {
                btnResetPassword.removeAttribute('disabled');
            } else {
                btnResetPassword.setAttribute('disabled', 'true');
            }
        }

        newPasswordInput.addEventListener('input', validatePassword);
        confirmPasswordInput.addEventListener('input', validatePassword);

        // BƯỚC 3: SUBMIT RESET PASSWORD
        btnResetPassword.addEventListener('click', async () => {
            const passVal = newPasswordInput.value;
            const confirmVal = confirmPasswordInput.value;
            if (passVal !== confirmVal) {
                Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Mật khẩu xác nhận không khớp!' });
                return;
            }
            btnResetPassword.disabled = true;
            btnResetPassword.innerText = 'Đang cập nhật...';

            try {
                const res = await fetch('/forgot-password/reset-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, newPassword: passVal, confirmPassword: confirmVal })
                });
                const data = await res.json();
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công',
                        text: 'Mật khẩu của bạn đã được đặt lại thành công. Hệ thống sẽ tự động chuyển về trang đăng nhập.',
                        timer: 2500,
                        showConfirmButton: false
                    });
                    setTimeout(() => {
                        window.location.href = '/login';
                    }, 2500);
                } else {
                    Swal.fire({ icon: 'error', title: 'Lỗi', text: data.message });
                    btnResetPassword.disabled = false;
                    btnResetPassword.innerText = 'Cập nhật mật khẩu mới';
                }
            } catch (err) {
                console.error(err);
                Swal.fire({ icon: 'error', title: 'Lỗi kết nối', text: 'Không thể kết nối với máy chủ.' });
                btnResetPassword.disabled = false;
                btnResetPassword.innerText = 'Cập nhật mật khẩu mới';
            }
        });
    </script>
</body>
</html>
