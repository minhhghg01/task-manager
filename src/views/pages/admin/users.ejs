<%- include('../../partials/header') %>

    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold text-primary mb-0">Quản lý Nhân sự</h2>
            <p class="text-muted small mb-0">Danh sách toàn bộ nhân viên và cấu hình phân quyền trong hệ thống.</p>
        </div>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <input type="text" id="tableSearchInput" class="form-control form-control-sm px-3 shadow-none border-secondary-subtle rounded-pill" placeholder="Tìm kiếm nhân viên..." style="width: 220px; height: 31px; font-size: 0.85rem;">
            <button class="btn btn-secondary btn-sm d-flex align-items-center gap-1 shadow-sm px-3" data-bs-toggle="modal" data-bs-target="#importExcelModal">
                <i data-feather="file-text" style="width: 16px; height: 16px;"></i> Nhập từ Excel
            </button>
            <button class="btn btn-success btn-sm d-flex align-items-center gap-1 shadow-sm px-3" data-bs-toggle="modal" data-bs-target="#addUserModal">
                <i data-feather="plus" style="width: 16px; height: 16px;"></i> Thêm Nhân viên
            </button>
        </div>
    </div>

    <!-- Table Container -->
    <div class="table-responsive shadow-sm">
        <table class="table table-hover align-middle" id="mainTable">
            <thead>
                <tr>
                    <th class="text-center" style="width: 50px;">STT</th>
                    <th style="width: 80px;">ID</th>
                    <th>Họ tên</th>
                    <th>Tài khoản</th>
                    <th>Khoa/Phòng</th>
                    <th>Chức vụ</th>
                    <th style="width: 130px;">Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach((u, index)=> { %>
                    <tr style="cursor: pointer;" onclick="window.location.href='/admin/users/detail/<%= u.id %>'">
                        <td class="text-center text-muted fw-bold">
                            <%= index + 1 %>
                        </td>
                        <td class="text-muted">
                            #<%= u.id %>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                    <%= u.fullname.split(' ').pop().charAt(0).toUpperCase() %>
                                </div>
                                <span class="fw-semibold"><%= u.fullname %></span>
                            </div>
                        </td>
                        <td class="text-secondary font-monospace">
                            <%= u.username %>
                        </td>
                        <td>
                            <span class="badge bg-primary bg-opacity-10 text-primary fw-medium border border-primary-subtle">
                                <%= u.Department ? u.Department.name : 'Chưa phân' %>
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-dark bg-opacity-10 text-dark fw-medium border border-dark-subtle dark-role-badge">
                                <%= u.role %>
                            </span>
                        </td>
                        <td>
                            <% if(u.status === 'active') { %>
                                <span class="badge-success badge small">Hoạt động</span>
                            <% } else { %>
                                <span class="badge-danger badge small">Khóa</span>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    <!-- Premium Pagination -->
    <div class="premium-pagination-container d-flex justify-content-between align-items-center flex-wrap gap-3 mt-4">
        <div class="premium-pagination-pill d-flex align-items-center bg-white shadow-sm border border-light-subtle rounded-pill px-3 py-2 gap-2">
            <!-- Navigation controls group -->
            <div class="premium-pagination-nav-group d-flex align-items-center">
                <!-- Left chevron -->
                <button class="btn btn-link p-0 text-secondary border-0 shadow-none d-flex align-items-center justify-content-center" id="btnPrev">
                    <i data-feather="chevron-left" style="width: 16px; height: 16px;"></i>
                </button>

                <!-- Page numbers container -->
                <div class="d-flex align-items-center gap-1" id="pageNumbers">
                </div>

                <!-- Right chevron -->
                <button class="btn btn-link p-0 text-secondary border-0 shadow-none d-flex align-items-center justify-content-center" id="btnNext">
                    <i data-feather="chevron-right" style="width: 16px; height: 16px;"></i>
                </button>
            </div>

            <!-- Divider line -->
            <div class="vr mx-1 my-2 text-secondary-subtle" style="width: 1px; height: 20px; opacity: 0.4;"></div>

            <!-- Page size selector -->
            <div class="d-flex align-items-center">
                <select id="pageSize" class="form-select form-select-sm border-0 bg-transparent px-2 py-0 shadow-none text-muted" style="width: auto; font-size: 0.85rem; cursor: pointer;">
                    <option value="10" selected>10 dòng / trang</option>
                    <option value="20">20 dòng / trang</option>
                    <option value="50">50 dòng / trang</option>
                    <option value="200">200 dòng / trang</option>
                    <option value="500">500 dòng / trang</option>
                    <option value="all">Tất cả dòng</option>
                </select>
            </div>

            <!-- Divider line -->
            <div class="vr mx-1 my-2 text-secondary-subtle" style="width: 1px; height: 20px; opacity: 0.4;"></div>

            <!-- Jump to page input -->
            <div class="d-flex align-items-center gap-1 text-muted small">
                <span>Đến trang</span>
                <input type="number" id="jumpPageInput" class="form-control form-control-sm text-center p-0 border border-secondary-subtle rounded-2 shadow-none" value="1" min="1" style="width: 40px; height: 26px; font-size: 0.85rem;">
            </div>
        </div>

        <!-- Total rows display -->
        <div id="paginationInfo" class="badge bg-light text-secondary border border-light-subtle rounded-pill px-3 py-2 fw-semibold fs-7">
        </div>
    </div>


    <!-- Modal Thêm Nhân Viên -->
    <div class="modal fade" id="addUserModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form action="/admin/users/create" method="POST" class="w-100">
                <div class="modal-content border-0 shadow-lg">
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                            <i data-feather="user-plus" class="text-primary"></i> Thêm Nhân viên Mới
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-muted">Họ và tên</label>
                            <input type="text" name="fullname" class="form-control" placeholder="Nhập họ và tên..." required>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold small text-muted">Username (Tài khoản)</label>
                                <input type="text" name="username" class="form-control" placeholder="Nhập tên đăng nhập..." required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold small text-muted">Password (Mật khẩu)</label>
                                <input type="password" name="password" class="form-control" placeholder="Tạo mật khẩu..." required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-muted">Khoa/Phòng</label>
                            <select name="departments_id" class="form-select">
                                <% departments.forEach(d=> { %>
                                    <option value="<%= d.id %>">
                                        <%= d.name %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-semibold small text-muted">Chức vụ</label>
                            <select name="role" class="form-select">
                                <option value="STAFF">Nhân viên (STAFF)</option>
                                <option value="LEADER">Tổ trưởng (LEADER)</option>
                                <option value="DEPUTY">Phó khoa (DEPUTY)</option>
                                <option value="HEAD">Trưởng khoa (HEAD)</option>
                                <option value="DEPUTY_DIRECTOR">Phó Giám Đốc (DEPUTY_DIRECTOR)</option>
                                <option value="DIRECTOR">Giám Đốc (DIRECTOR)</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer bg-light bg-opacity-50">
                        <button type="button" class="btn btn-secondary px-4 py-2 border-0 bg-transparent text-muted" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary px-4 py-2">Tạo mới</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Import Excel -->
    <div class="modal fade" id="importExcelModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form action="/admin/import/excel" method="POST" enctype="multipart/form-data" class="w-100">
                <div class="modal-content border-0 shadow-lg">
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                            <i data-feather="upload-cloud" class="text-primary"></i> Nhập Dữ Liệu từ Excel
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="alert alert-info py-2.5 small border-0 bg-primary bg-opacity-10 text-primary mb-3">
                            <i data-feather="info" class="me-1" style="width: 16px; height: 16px; vertical-align: text-bottom;"></i>
                            Vui lòng tải file mẫu Excel gồm 2 sheet <strong>KhoaPhong</strong> và <strong>NhanVien</strong> để điền đúng định dạng.
                        </div>
                        <div class="mb-4 text-center">
                            <a href="/admin/import/template" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1 shadow-none">
                                <i data-feather="download" style="width: 16px; height: 16px;"></i> Tải file mẫu Excel (.xlsx)
                            </a>
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-semibold small text-muted">Chọn File Excel</label>
                            <input type="file" name="importFile" class="form-control" accept=".xlsx, .xls" required>
                        </div>
                    </div>
                    <div class="modal-footer bg-light bg-opacity-50">
                        <button type="button" class="btn btn-secondary px-4 py-2 border-0 bg-transparent text-muted" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary px-4 py-2">Nhập Dữ Liệu</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- CSS bổ sung để đảm bảo hiển thị badge chức vụ tốt trong Dark Mode -->
    <style>
        [data-bs-theme="dark"] .dark-role-badge {
            background-color: rgba(255, 255, 255, 0.1) !important;
            color: rgba(255, 255, 255, 0.8) !important;
            border-color: rgba(255, 255, 255, 0.15) !important;
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('importSuccess') === 'true') {
                const depts = urlParams.get('depts') || 0;
                const users = urlParams.get('users') || 0;
                Swal.fire({
                    title: 'Nhập dữ liệu thành công!',
                    html: `<div class="text-start">
                             <p class="mb-1"><i data-feather="check" class="text-success me-1"></i> Khoa/Phòng đã tạo/cập nhật: <strong>${depts}</strong></p>
                             <p class="mb-0"><i data-feather="check" class="text-success me-1"></i> Nhân viên đã tạo/cập nhật: <strong>${users}</strong></p>
                           </div>`,
                    icon: 'success',
                    confirmButtonText: 'Đồng ý',
                    confirmButtonColor: 'var(--accent-indigo)'
                }).then(() => {
                    feather.replace();
                });
                window.history.replaceState({}, document.title, window.location.pathname);
            }
        });
    </script>
 
    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const table = document.getElementById("mainTable");
            if (!table) return;
            const tbody = table.querySelector("tbody");
            const allRows = Array.from(tbody.querySelectorAll("tr"));
            
            let currentPage = 1;
            let rowsPerPage = 10;
            let filteredRows = [...allRows];
            
            function renderPagination() {
                const totalRows = filteredRows.length;
                const pageSizeSelect = document.getElementById('pageSize').value;
                rowsPerPage = pageSizeSelect === 'all' ? totalRows : parseInt(pageSizeSelect);

                const totalPages = rowsPerPage === 0 ? 1 : Math.ceil(totalRows / rowsPerPage);
                if (currentPage > totalPages) currentPage = totalPages || 1;

                const start = rowsPerPage === totalRows ? 0 : (currentPage - 1) * rowsPerPage;
                const end = Math.min(start + rowsPerPage, totalRows);

                allRows.forEach(row => row.style.display = 'none');
                filteredRows.forEach(row => tbody.appendChild(row));
                for (let i = start; i < end; i++) {
                    if (filteredRows[i]) {
                        filteredRows[i].style.display = '';
                        const indexCell = filteredRows[i].cells[0];
                        if (indexCell && indexCell.classList.contains('text-center')) {
                            indexCell.innerText = i + 1;
                        }
                    }
                }

                let emptyRow = document.getElementById("emptyRow");
                if (totalRows === 0) {
                    if (!emptyRow) {
                        const colCount = table.querySelectorAll("thead th").length;
                        tbody.insertAdjacentHTML('beforeend', `<tr id="emptyRow"><td colspan="${colCount}" class="text-center py-5 text-muted">Không có dữ liệu phù hợp</td></tr>`);
                    }
                } else if (emptyRow) {
                    emptyRow.remove();
                }

                const infoEl = document.getElementById('paginationInfo');
                if (infoEl) {
                    if (totalRows === 0) {
                        infoEl.innerHTML = "0/0";
                    } else {
                        infoEl.innerHTML = `Hiển thị: ${end - start}/${totalRows}`;
                    }
                }

                const btnPrev = document.getElementById('btnPrev');
                const btnNext = document.getElementById('btnNext');
                
                if (btnPrev && btnNext) {
                    if (currentPage === 1) {
                        btnPrev.setAttribute('disabled', 'true');
                        btnPrev.style.opacity = '0.4';
                        btnPrev.onclick = null;
                    } else {
                        btnPrev.removeAttribute('disabled');
                        btnPrev.style.opacity = '1';
                        btnPrev.onclick = function() { changePage(currentPage - 1); return false; };
                    }

                    if (currentPage === totalPages) {
                        btnNext.setAttribute('disabled', 'true');
                        btnNext.style.opacity = '0.4';
                        btnNext.onclick = null;
                    } else {
                        btnNext.removeAttribute('disabled');
                        btnNext.style.opacity = '1';
                        btnNext.onclick = function() { changePage(currentPage + 1); return false; };
                    }
                }

                const pageNumbersContainer = document.getElementById('pageNumbers');
                if (pageNumbersContainer) {
                    pageNumbersContainer.innerHTML = '';
                    for (let i = 1; i <= totalPages; i++) {
                        if (totalPages > 6) {
                            if (i !== 1 && i !== totalPages && Math.abs(i - currentPage) > 1) {
                                if (i === 2 || i === totalPages - 1) {
                                    pageNumbersContainer.innerHTML += `<span class="text-muted small px-1">...</span>`;
                                }
                                continue;
                            }
                        }
                        pageNumbersContainer.innerHTML += `<a href="#" class="page-num ${i === currentPage ? 'active' : ''}" onclick="changePage(${i}); return false;">${i}</a>`;
                    }
                }
                
                const jumpInput = document.getElementById('jumpPageInput');
                if (jumpInput) {
                    jumpInput.value = currentPage;
                    jumpInput.max = totalPages;
                    jumpInput.onchange = function() {
                        let val = parseInt(this.value);
                        if (isNaN(val) || val < 1) val = 1;
                        if (val > totalPages) val = totalPages;
                        changePage(val);
                    };
                    jumpInput.onkeydown = function(e) {
                        if (e.key === 'Enter') {
                            let val = parseInt(this.value);
                            if (isNaN(val) || val < 1) val = 1;
                            if (val > totalPages) val = totalPages;
                            changePage(val);
                            e.preventDefault();
                        }
                    };
                }
            }

            window.changePage = function (page) {
                currentPage = page;
                renderPagination();
            };

            const searchInput = document.getElementById('tableSearchInput');
            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    const query = this.value.toLowerCase().trim();
                    filteredRows = allRows.filter(row => {
                        if (row.id === 'emptyRow') return false;
                        return row.innerText.toLowerCase().includes(query);
                    });
                    currentPage = 1;
                    renderPagination();
                });
            }

            let currentSortCol = -1;
            let currentSortDir = 'asc';

            window.sortTable = function(colIndex) {
                if (colIndex === 0) return;
                
                if (currentSortCol === colIndex) {
                    currentSortDir = currentSortDir === 'asc' ? 'desc' : 'asc';
                } else {
                    currentSortCol = colIndex;
                    currentSortDir = 'asc';
                }

                const headers = table.querySelectorAll('thead tr th');
                headers.forEach((th, idx) => {
                    if (idx === 0) return;
                    let baseText = th.innerText.replace(/[▲▼⇅]/g, '').trim();
                    if (idx === colIndex) {
                        th.innerText = baseText + (currentSortDir === 'asc' ? ' ▲' : ' ▼');
                    } else {
                        th.innerText = baseText + ' ⇅';
                    }
                });

                filteredRows.sort((rowA, rowB) => {
                    let cellA = rowA.cells[colIndex] ? rowA.cells[colIndex].innerText.trim() : '';
                    let cellB = rowB.cells[colIndex] ? rowB.cells[colIndex].innerText.trim() : '';

                    if (cellA.includes('/') || cellB.includes('/')) {
                        const parseDate = (str) => {
                            if (!str || str === '-' || str === '---') return new Date(0);
                            let cleaned = str.replace(',', '').trim();
                            let parts = cleaned.split(/\s+/);
                            let datePart = '';
                            let timePart = '00:00:00';
                            
                            parts.forEach(p => {
                                if (p.includes('/')) datePart = p;
                                else if (p.includes(':')) timePart = p;
                            });

                            if (!datePart) return new Date(0);
                            let dParts = datePart.split('/');
                            let tParts = timePart.split(':');
                            return new Date(
                                parseInt(dParts[2]),
                                parseInt(dParts[1]) - 1,
                                parseInt(dParts[0]),
                                parseInt(tParts[0] || 0),
                                parseInt(tParts[1] || 0),
                                parseInt(tParts[2] || 0)
                            );
                        };
                        let dateA = parseDate(cellA);
                        let dateB = parseDate(cellB);
                        return currentSortDir === 'asc' ? dateA - dateB : dateB - dateA;
                    }

                    let numA = parseFloat(cellA.replace(/[^\d.-]/g, ''));
                    let numB = parseFloat(cellB.replace(/[^\d.-]/g, ''));
                    if (!isNaN(numA) && !isNaN(numB)) {
                        return currentSortDir === 'asc' ? numA - numB : numB - numA;
                    }

                    return currentSortDir === 'asc' 
                        ? cellA.localeCompare(cellB, 'vi', { sensitivity: 'base' })
                        : cellB.localeCompare(cellA, 'vi', { sensitivity: 'base' });
                });

                currentPage = 1;
                renderPagination();
            };

            const headers = table.querySelectorAll('thead tr th');
            headers.forEach((th, idx) => {
                if (idx > 0) {
                    th.style.cursor = 'pointer';
                    th.innerText = th.innerText + ' ⇅';
                    th.addEventListener('click', () => sortTable(idx));
                }
            });

            document.getElementById('pageSize')?.addEventListener('change', () => {
                currentPage = 1;
                renderPagination();
            });

            renderPagination();
        });
    </script>

    <%- include('../../partials/footer') %>