<%- include('../../partials/header') %>

    <!-- Header Section -->
    <div class="mb-4 border-bottom pb-3">
        <h2 class="fw-bold text-primary mb-1">Lịch sử tác động hệ thống</h2>
        <p class="text-muted small mb-0">Theo dõi nhật ký các hoạt động đăng nhập, tạo, sửa đổi và xóa dữ liệu trên hệ thống.</p>
    </div>

    <!-- Table Container -->
    <div class="table-responsive shadow-sm">
        <table class="table table-hover align-middle datatable-init">
            <thead>
                <tr>
                    <th class="text-center" style="width: 60px;">STT</th>
                    <th style="width: 170px;">Thời gian</th>
                    <th style="width: 220px;">Người thực hiện</th>
                    <th style="width: 110px;">Hành động</th>
                    <th style="width: 180px;">Đối tượng</th>
                    <th>Chi tiết hoạt động</th>
                </tr>
            </thead>
            <tbody>
                <% logs.forEach((log, index)=> { %>
                    <tr>
                        <td class="text-center text-muted fw-bold">
                            <%= index + 1 %>
                        </td>
                        <td class="text-secondary small">
                            <i data-feather="calendar" style="width: 14px; height: 14px; vertical-align: middle; margin-right: 4px;"></i>
                            <%= new Date(log.createdAt).toLocaleString('vi-VN') %>
                        </td>
                        <td>
                            <% if (log.User) { %>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-secondary bg-opacity-10 text-secondary d-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; font-size: 0.8rem;">
                                        <%= log.User.fullname.split(' ').pop().charAt(0).toUpperCase() %>
                                    </div>
                                    <div>
                                        <span class="fw-semibold d-block" style="font-size: 0.9rem;"><%= log.User.fullname %></span>
                                        <small class="text-muted font-monospace" style="font-size: 0.75rem;"><%= log.User.username %></small>
                                    </div>
                                </div>
                            <% } else { %>
                                <span class="text-danger small"><i data-feather="user-x" style="width: 14px; height: 14px;"></i> Đã xóa</span>
                            <% } %>
                        </td>
                        <td>
                            <% 
                               let badgeClass = 'bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle'; 
                               if (log.action === 'CREATE') badgeClass = 'badge-success'; 
                               else if (log.action === 'UPDATE') badgeClass = 'badge-warning'; 
                               else if (log.action === 'DELETE') badgeClass = 'badge-danger'; 
                               else if (log.action === 'LOGIN') badgeClass = 'badge-info'; 
                               else if (log.action === 'LOGOUT') badgeClass = 'bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle'; 
                            %>
                            <span class="badge <%= badgeClass %> small fw-bold">
                                <%= log.action %>
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border border-secondary-subtle text-uppercase font-monospace" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                <%= log.entity_type %>
                            </span>
                            <small class="text-muted d-block mt-1 font-monospace" style="font-size: 0.75rem;">ID: #<%= log.entity_id %></small>
                        </td>
                        <td class="text-secondary small">
                            <%= log.details %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <%- include('../../partials/footer') %>