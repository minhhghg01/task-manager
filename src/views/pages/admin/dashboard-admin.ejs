<%- include('../../partials/header') %>

    <div class="pt-3 pb-2 mb-4 border-bottom">
        <h2 class="fw-bold text-primary">Tổng quan hệ thống (Admin Dashboard)</h2>
        <p class="text-muted small mb-0">Theo dõi số liệu thống kê khoa phòng, nhân sự và tình hình công việc toàn viện.</p>
    </div>

    <!-- Hàng thống kê chung -->
    <div class="row g-4 mb-5">
        <div class="col-12 col-md-4">
            <div class="metric-card primary h-100 shadow-sm border-0 d-flex flex-column justify-content-between" onclick="window.location.href='/admin/departments'">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-uppercase text-muted fw-bold small" style="letter-spacing: 0.5px;">Khoa / Phòng</span>
                        <div class="p-2 bg-primary bg-opacity-10 text-primary rounded">
                            <i data-feather="layers" style="width: 20px; height: 20px;"></i>
                        </div>
                    </div>
                    <h1 class="display-5 fw-bold mb-0">
                        <%= stats.totalDepartments %>
                    </h1>
                </div>
                <div class="mt-3 pt-3 border-top border-light-subtle d-none d-md-block">
                    <a href="/admin/departments" class="small text-decoration-none fw-semibold text-primary d-flex align-items-center gap-1">
                        Quản lý khoa phòng <i data-feather="chevron-right" style="width: 14px; height: 14px;"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="metric-card success h-100 shadow-sm border-0 d-flex flex-column justify-content-between" onclick="window.location.href='/admin/users'">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-uppercase text-muted fw-bold small" style="letter-spacing: 0.5px;">Tổng Nhân sự</span>
                        <div class="p-2 bg-success bg-opacity-10 text-success rounded">
                            <i data-feather="users" style="width: 20px; height: 20px;"></i>
                        </div>
                    </div>
                    <h1 class="display-5 fw-bold mb-0">
                        <%= stats.totalUsers %>
                    </h1>
                </div>
                <div class="mt-3 pt-3 border-top border-light-subtle d-none d-md-block">
                    <a href="/admin/users" class="small text-decoration-none fw-semibold text-success d-flex align-items-center gap-1">
                        Quản lý nhân sự <i data-feather="chevron-right" style="width: 14px; height: 14px;"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="metric-card info h-100 shadow-sm border-0 d-flex flex-column justify-content-between" onclick="window.location.href='/tasks/general'">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-uppercase text-muted fw-bold small" style="letter-spacing: 0.5px;">Tổng Công việc</span>
                        <div class="p-2 bg-info bg-opacity-10 text-info rounded">
                            <i data-feather="briefcase" style="width: 20px; height: 20px;"></i>
                        </div>
                    </div>
                    <h1 class="display-5 fw-bold mb-0">
                        <%= stats.totalTasks %>
                    </h1>
                </div>
                <div class="mt-3 pt-3 border-top border-light-subtle d-none d-md-block">
                    <a href="/tasks/general" class="small text-decoration-none fw-semibold text-info d-flex align-items-center gap-1">
                        Xem công việc chung <i data-feather="chevron-right" style="width: 14px; height: 14px;"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Tình trạng công việc toàn viện -->
    <h4 class="mb-3 fw-bold text-secondary">Tình trạng công việc toàn viện</h4>
    
    <div class="row g-4">
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm border-0" style="border-left: 4px solid var(--status-success) !important;">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-uppercase text-muted fw-bold mb-2 small" style="letter-spacing: 0.5px;">Đã hoàn thành</h6>
                        <h2 class="fw-bold text-success mb-0">
                            <%= stats.completed %>
                        </h2>
                    </div>
                    <div class="p-3 rounded-circle bg-success bg-opacity-10 text-success">
                        <i data-feather="check-circle" style="width: 28px; height: 28px;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm border-0" style="border-left: 4px solid var(--status-warning) !important;">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-uppercase text-muted fw-bold mb-2 small" style="letter-spacing: 0.5px;">Đang thực hiện</h6>
                        <h2 class="fw-bold text-warning mb-0">
                            <%= stats.inProgress %>
                        </h2>
                        <small class="text-muted d-block mt-1">Mới tạo, đang làm, chờ duyệt</small>
                    </div>
                    <div class="p-3 rounded-circle bg-warning bg-opacity-10 text-warning">
                        <i data-feather="clock" style="width: 28px; height: 28px;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm border-0" style="border-left: 4px solid var(--status-danger) !important;">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-uppercase text-muted fw-bold mb-2 small" style="letter-spacing: 0.5px;">Quá hạn</h6>
                        <h2 class="fw-bold text-danger mb-0">
                            <%= stats.overdue %>
                        </h2>
                        <small class="text-danger d-block mt-1">Cần đôn đốc xử lý gấp</small>
                    </div>
                    <div class="p-3 rounded-circle bg-danger bg-opacity-10 text-danger">
                        <i data-feather="alert-triangle" style="width: 28px; height: 28px;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

<%- include('../../partials/footer') %>