<%- include('../../partials/header') %>
    <div class="container mt-2 max-width-container">
        <!-- Breadcrumb / Header Actions -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 border-bottom pb-3">
            <div>
                <h3 class="fw-bold text-primary mb-1">Chi tiết Nhân sự</h3>
                <p class="text-muted small mb-0">Xem và cập nhật thông tin tài khoản, phòng ban, vai trò của nhân sự.</p>
            </div>

            <button type="button"
                onclick="confirmDelete('/admin/users/delete/<%= targetUser.id %>', 'Xóa nhân viên <%= targetUser.fullname %>?')"
                class="btn btn-danger btn-sm d-flex align-items-center gap-1 shadow-none">
                <i data-feather="trash-2" style="width: 16px; height: 16px;"></i> Xóa nhân viên này
            </button>
        </div>

        <!-- Form Card Container -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-transparent py-3 border-bottom d-flex align-items-center gap-2">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px;">
                    <i data-feather="user" style="width: 18px; height: 18px;"></i>
                </div>
                <div>
                    <h5 class="mb-0 fw-bold"><%= targetUser.fullname %></h5>
                    <small class="text-muted">Tài khoản: <%= targetUser.username %> | ID: #<%= targetUser.id %></small>
                </div>
            </div>
            
            <div class="card-body p-4">
                <form action="/admin/users/update/<%= targetUser.id %>" method="POST">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold small text-muted">Họ và tên</label>
                            <input type="text" name="fullname" class="form-control" value="<%= targetUser.fullname %>"
                                placeholder="Nhập họ và tên..." required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold small text-muted">Tài khoản đăng nhập (Username)</label>
                            <input type="text" name="username" class="form-control" value="<%= targetUser.username %>"
                                placeholder="Nhập tên tài khoản..." required>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold small text-muted">Khoa / Phòng</label>
                            <select name="departments_id" class="form-select">
                                <option value="" <%= !targetUser.departments_id ? 'selected' : '' %>>-- Chưa phân phòng ban --</option>
                                <% departments.forEach(d=> { %>
                                    <option value="<%= d.id %>" <%=targetUser.departments_id==d.id ? 'selected' : '' %>>
                                        <%= d.name %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold small text-muted">Chức vụ hệ thống</label>
                            <select name="role" class="form-select">
                                <% ['STAFF','LEADER','DEPUTY','HEAD','DEPUTY_DIRECTOR','DIRECTOR','ADMIN'].forEach(r=> { %>
                                    <option value="<%= r %>" <%=targetUser.role==r ? 'selected' : '' %>><%= r %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-semibold small text-muted">Gmail</label>
                            <input type="email" name="gmail" class="form-control" value="<%= targetUser.gmail || '' %>" placeholder="Nhập địa chỉ Gmail..." required>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold small text-muted">Trạng thái tài khoản</label>
                            <select name="status" class="form-select">
                                <option value="active" <%=targetUser.status=='active' ? 'selected' : '' %>>Hoạt động (Active)</option>
                                <option value="inactive" <%=targetUser.status=='inactive' ? 'selected' : '' %>>Đã khóa (Locked)</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold small text-muted">Đổi mật khẩu mới (Để trống nếu không đổi)</label>
                            <input type="password" name="password" class="form-control" placeholder="Nhập mật khẩu mới...">
                        </div>
                    </div>

                    <!-- Actions Form Buttons -->
                    <div class="d-flex justify-content-end align-items-center gap-2 mt-4 pt-3 border-top">
                        <a href="/admin/users" class="btn btn-secondary border-0 bg-transparent text-muted px-4 py-2">Quay lại danh sách</a>
                        <button type="submit" class="btn btn-success d-flex align-items-center gap-1 px-4 py-2">
                            <i data-feather="save" style="width: 16px; height: 16px;"></i> Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Giới hạn chiều rộng container chính để hiển thị cân đối trên màn hình lớn -->
    <style>
        .max-width-container {
            max-width: 900px;
            margin-left: auto;
            margin-right: auto;
        }
    </style>
    <%- include('../../partials/footer') %>