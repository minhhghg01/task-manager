<%- include('../../partials/header') %>

    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold text-primary mb-0">Quản lý Khoa/Phòng</h2>
            <p class="text-muted small mb-0">Danh sách các khoa phòng, trung tâm và bộ phận trực thuộc viện.</p>
        </div>
        <button class="btn btn-success btn-sm d-flex align-items-center gap-1 shadow-sm px-3" data-bs-toggle="modal" data-bs-target="#addDeptModal">
            <i data-feather="plus" style="width: 16px; height: 16px;"></i> Thêm Khoa mới
        </button>
    </div>

    <!-- Table Container -->
    <div class="table-responsive shadow-sm">
        <table class="table table-hover align-middle datatable-init">
            <thead>
                <tr>
                    <th class="text-center" style="width: 60px;">STT</th>
                    <th style="width: 100px;">ID</th>
                    <th>Tên Khoa / Phòng</th>
                    <th>Mã viết tắt</th>
                    <th style="width: 150px;">Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                <% departments.forEach((d, index)=> { %>
                    <tr style="cursor: pointer;" onclick="window.location.href='/admin/departments/detail/<%= d.id %>'">
                        <td class="text-center text-muted fw-bold">
                            <%= index + 1 %>
                        </td>
                        <td class="text-muted font-monospace">
                            #<%= d.id %>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                    <%= d.name.charAt(0).toUpperCase() %>
                                </div>
                                <span class="fw-semibold"><%= d.name %></span>
                            </div>
                        </td>
                        <td class="text-secondary fw-semibold">
                            <%= d.code %>
                        </td>
                        <td>
                            <% if(d.status === 'active') { %>
                                <span class="badge-success badge small">Hoạt động</span>
                            <% } else { %>
                                <span class="badge-danger badge small">Ngừng hoạt động</span>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <!-- Modal Thêm Khoa Mới -->
    <div class="modal fade" id="addDeptModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form action="/admin/departments/create" method="POST" class="w-100">
                <div class="modal-content border-0 shadow-lg">
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                            <i data-feather="plus-square" class="text-primary"></i> Thêm Khoa/Phòng Mới
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-muted">Tên Khoa/Phòng</label>
                            <input type="text" name="name" class="form-control" placeholder="Nhập tên khoa phòng..." required>
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-semibold small text-muted">Mã viết tắt (Ví dụ: IT, BOD, KHCS...)</label>
                            <input type="text" name="code" class="form-control" placeholder="Nhập mã viết tắt..." required>
                        </div>
                    </div>
                    <div class="modal-footer bg-light bg-opacity-50">
                        <button type="button" class="btn btn-secondary px-4 py-2 border-0 bg-transparent text-muted" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary px-4 py-2">Lưu lại</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <%- include('../../partials/footer') %>