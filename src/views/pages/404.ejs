<% if (locals.user) { %>
    <%- include('../partials/header') %>
    
    <div class="container-fluid text-center py-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="display-1 fw-bold text-danger mb-4">404</div>
                <h3 class="fw-bold mb-3">Không tìm thấy trang</h3>
                <p class="text-muted mb-4">Trang bạn đang tìm kiếm không tồn tại hoặc đã bị di chuyển.</p>
                <a href="/dashboard" class="btn btn-primary px-4 rounded-pill">
                    <i data-feather="home" style="width: 16px; height: 16px; margin-right: 6px;"></i>Quay lại Trang chủ
                </a>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>
<% } else { %>
    <!DOCTYPE html>
    <html lang="vi">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>404 - Không tìm thấy trang</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <style>
            body {
                background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
                height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: system-ui, -apple-system, sans-serif;
            }
            .card-404 {
                width: 100%;
                max-width: 500px;
                padding: 40px;
                background: white;
                border-radius: 16px;
                box-shadow: 0 8px 24px rgba(0,0,0,0.08);
            }
        </style>
    </head>
    <body>
        <div class="card-404 text-center">
            <div class="display-1 fw-bold text-danger mb-3">404</div>
            <h3 class="fw-bold mb-2">Không tìm thấy trang</h3>
            <p class="text-muted mb-4">Đường dẫn bạn truy cập không tồn tại trong hệ thống.</p>
            <a href="/login" class="btn btn-primary w-100 py-2 fw-bold">Đăng nhập hệ thống</a>
        </div>
    </body>
    </html>
<% } %>
