<%- include('../partials/header') %>

<div class="container-fluid px-4 py-3">
    <!-- TIÊU ĐỀ TRANG -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-1">Báo Cáo & Thống Kê Công Việc</h2>
            <p class="text-muted mb-0 small">Xuất báo cáo tiến độ công việc chung theo khoa phòng, nhân viên và thời gian</p>
        </div>
    </div>

    <!-- KHU VỰC BỘ LỌC -->
    <div class="card shadow-sm border-0 mb-4 bg-body-tertiary" style="border: 1px solid var(--border-color) !important;">
        <div class="card-body">
            <form id="reportForm" action="/reports/export" method="GET">
                <div class="row g-3 align-items-end">
                    <!-- Chọn Khoa Phòng -->
                    <div class="col-md-2">
                        <label class="form-label fw-semibold text-muted small">Khoa / Phòng</label>
                        <select class="form-select border-0 shadow-sm" id="departmentFilter" name="departmentId" onchange="updateUsersList()">
                            <% if (['ADMIN', 'DIRECTOR'].includes(user.role)) { %>
                                <option value="all">-- Tất cả khoa phòng --</option>
                            <% } %>
                            <% departments.forEach(dept => { %>
                                <option value="<%= dept.id %>" <%= String(dept.id) === String(defaultDeptId) ? 'selected' : '' %>>
                                    <%= dept.name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <!-- Chọn Nhân Viên -->
                    <div class="col-md-2">
                        <label class="form-label fw-semibold text-muted small">Nhân viên thực hiện</label>
                        <select class="form-select border-0 shadow-sm" id="userFilter" name="userId" onchange="refreshPreview()">
                            <option value="all">-- Tất cả nhân viên --</option>
                            <% usersInDept.forEach(u => { %>
                                <option value="<%= u.id %>">
                                    <%= u.fullname %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <!-- Lọc nhanh thời gian -->
                    <div class="col-md-2">
                        <label class="form-label fw-semibold text-muted small">Lọc thời gian nhanh</label>
                        <select class="form-select border-0 shadow-sm" id="timePresetFilter" onchange="applyTimePreset()">
                            <option value="custom">-- Tùy chọn --</option>
                            <option value="today">Hôm nay</option>
                            <option value="month">Tháng này</option>
                            <option value="quarter">Quý này</option>
                            <option value="year">Năm nay</option>
                        </select>
                    </div>

                    <!-- Từ Ngày -->
                    <div class="col-md-2">
                        <label class="form-label fw-semibold text-muted small">Từ ngày (Ngày tạo)</label>
                        <input type="date" class="form-control border-0 shadow-sm" id="startDateFilter" name="startDate" onchange="resetTimePreset()">
                    </div>

                    <!-- Đến Ngày -->
                    <div class="col-md-2">
                        <label class="form-label fw-semibold text-muted small">Đến ngày</label>
                        <input type="date" class="form-control border-0 shadow-sm" id="endDateFilter" name="endDate" onchange="resetTimePreset()">
                    </div>

                    <!-- Nút Hành Động -->
                    <div class="col-md-2 d-flex gap-2">
                        <button type="button" class="btn btn-outline-primary flex-grow-1 shadow-sm border-0 bg-body" onclick="refreshPreview()">
                            <span data-feather="refresh-cw" class="me-1"></span> Lọc
                        </button>
                        <button type="submit" class="btn btn-success flex-grow-1 shadow-sm border-0">
                            <span data-feather="file-text" class="me-1"></span> Xuất Excel
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- KHU VỰC THỐNG KÊ BIỂU ĐỒ -->
    <div id="statsLoading" class="text-center py-5 text-muted d-none">
        <div class="spinner-border text-primary mb-2" role="status"></div>
        <p class="mb-0">Đang phân tích số liệu thống kê...</p>
    </div>

    <div id="statsDashboard">
        <!-- KPI Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm bg-primary text-white h-100">
                    <div class="card-body d-flex align-items-center justify-content-between p-4">
                        <div>
                            <h6 class="text-white-50 fw-bold small text-uppercase mb-1">Tổng công việc</h6>
                            <h2 class="fw-bold mb-0" id="kpiTotal">0</h2>
                        </div>
                        <div class="rounded-circle bg-white bg-opacity-25 p-3">
                            <span data-feather="briefcase" style="width: 24px; height: 24px;"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm bg-success text-white h-100">
                    <div class="card-body d-flex align-items-center justify-content-between p-4">
                        <div>
                            <h6 class="text-white-50 fw-bold small text-uppercase mb-1">Đã hoàn thành</h6>
                            <h2 class="fw-bold mb-0" id="kpiCompleted">0</h2>
                        </div>
                        <div class="rounded-circle bg-white bg-opacity-25 p-3">
                            <span data-feather="check-circle" style="width: 24px; height: 24px;"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm bg-info text-white h-100">
                    <div class="card-body d-flex align-items-center justify-content-between p-4">
                        <div>
                            <h6 class="text-white-50 fw-bold small text-uppercase mb-1">Đang thực hiện</h6>
                            <h2 class="fw-bold mb-0" id="kpiInProgress">0</h2>
                        </div>
                        <div class="rounded-circle bg-white bg-opacity-25 p-3">
                            <span data-feather="play-circle" style="width: 24px; height: 24px;"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm bg-danger text-white h-100">
                    <div class="card-body d-flex align-items-center justify-content-between p-4">
                        <div>
                            <h6 class="text-white-50 fw-bold small text-uppercase mb-1">Quá hạn</h6>
                            <h2 class="fw-bold mb-0" id="kpiOverdue">0</h2>
                        </div>
                        <div class="rounded-circle bg-white bg-opacity-25 p-3">
                            <span data-feather="alert-triangle" style="width: 24px; height: 24px;"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <!-- Biểu đồ trạng thái công việc (Doughnut) -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                        <h5 class="card-title fw-bold mb-1">Tỷ lệ Trạng thái Công việc</h5>
                        <p class="text-muted small mb-0">Biểu đồ thể hiện phần trăm phân bổ trạng thái</p>
                    </div>
                    <div class="card-body d-flex flex-column align-items-center justify-content-center p-4" style="min-height: 360px;">
                        <div id="statusChartContainer" style="position: relative; height:300px; width:100%">
                            <canvas id="statusChart"></canvas>
                        </div>
                        <div id="noDataStatus" class="text-muted d-none">Không có dữ liệu công việc</div>
                    </div>
                </div>
            </div>

            <!-- Biểu đồ phân bổ độ ưu tiên (Bar Chart) -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                        <h5 class="card-title fw-bold mb-1">Số lượng theo Độ ưu tiên</h5>
                        <p class="text-muted small mb-0">Thống kê số lượng công việc theo mức độ quan trọng</p>
                    </div>
                    <div class="card-body d-flex flex-column align-items-center justify-content-center p-4" style="min-height: 360px;">
                        <div id="priorityChartContainer" style="position: relative; height:300px; width:100%">
                            <canvas id="priorityChart"></canvas>
                        </div>
                        <div id="noDataPriority" class="text-muted d-none">Không có dữ liệu công việc</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Biểu đồ phân bổ công việc chi tiết theo Khoa/Phòng hoặc Nhân viên (Grouped Stacked Bar) -->
        <div class="row g-4 mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                        <h5 class="card-title fw-bold mb-1" id="employeeChartTitle">Thống kê công việc chi tiết</h5>
                        <p class="text-muted small mb-0" id="employeeChartSubtitle">Biểu đồ thể hiện mức độ và tiến độ công việc</p>
                    </div>
                    <div class="card-body p-4" style="min-height: 400px; position: relative;">
                        <div id="employeeTaskChartContainer" style="position: relative; height:360px; width:100%">
                            <canvas id="employeeTaskChart"></canvas>
                        </div>
                        <div id="noDataEmployeeTask" class="text-muted text-center d-none py-5">Không có dữ liệu công việc để thống kê</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<!-- SCRIPTS HỖ TRỢ HIỆU ỨNG VÀ AJAX PREVIEW -->
<script>
    // Toàn bộ danh sách nhân viên để filter động trên client
    const allUsers = <%- JSON.stringify(usersInDept) %>;

    // Hàm chuyển đổi bộ lọc thời gian nhanh
    function applyTimePreset() {
        const preset = document.getElementById('timePresetFilter').value;
        if (preset === 'custom') return;

        const startInput = document.getElementById('startDateFilter');
        const endInput = document.getElementById('endDateFilter');

        const now = new Date();
        let startDate, endDate;

        function formatDate(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        switch (preset) {
            case 'today':
                startDate = now;
                endDate = now;
                break;
            case 'month':
                startDate = new Date(now.getFullYear(), now.getMonth(), 1);
                endDate = new Date(now.getFullYear(), now.getMonth() + 1, 0);
                break;
            case 'quarter':
                const quarter = Math.floor(now.getMonth() / 3);
                startDate = new Date(now.getFullYear(), quarter * 3, 1);
                endDate = new Date(now.getFullYear(), (quarter + 1) * 3, 0);
                break;
            case 'year':
                startDate = new Date(now.getFullYear(), 0, 1);
                endDate = new Date(now.getFullYear(), 11, 31);
                break;
        }

        startInput.value = formatDate(startDate);
        endInput.value = formatDate(endDate);

        refreshPreview();
    }

    function resetTimePreset() {
        document.getElementById('timePresetFilter').value = 'custom';
        refreshPreview();
    }

    // Cập nhật danh sách nhân viên khi đổi khoa phòng
    function updateUsersList() {
        const deptId = document.getElementById('departmentFilter').value;
        const userSelect = document.getElementById('userFilter');
        
        userSelect.innerHTML = '<option value="all">-- Tất cả nhân viên --</option>';
        
        const filtered = allUsers.filter(u => deptId === 'all' || String(u.departments_id) === String(deptId));
        filtered.forEach(u => {
            const opt = document.createElement('option');
            opt.value = u.id;
            opt.textContent = `${u.fullname}`;
            userSelect.appendChild(opt);
        });

        refreshPreview();
    }

    // Refresh dữ liệu preview bảng
    function refreshPreview() {
        const deptId = document.getElementById('departmentFilter').value;
        const userId = document.getElementById('userFilter').value;
        const startDate = document.getElementById('startDateFilter').value;
        const endDate = document.getElementById('endDateFilter').value;

        const loader = document.getElementById('statsLoading');
        const dashboard = document.getElementById('statsDashboard');

        loader.classList.remove('d-none');
        dashboard.style.opacity = '0.5'; // Làm mờ nhẹ dashboard cũ khi đang tải

        const queryParams = new URLSearchParams({
            departmentId: deptId,
            userId: userId,
            startDate: startDate,
            endDate: endDate
        });

        fetch(`/reports/preview?${queryParams.toString()}`)
            .then(res => res.json())
            .then(data => {
                loader.classList.add('d-none');
                dashboard.style.opacity = '1';
                if (data.success) {
                    renderCharts(data.tasks);
                } else {
                    showAlert('Lỗi', 'Lỗi khi tải số liệu: ' + data.message, 'error');
                }
            })
            .catch(err => {
                console.error(err);
                loader.classList.add('d-none');
                dashboard.style.opacity = '1';
                showAlert('Thất bại', 'Không thể kết nối đến máy chủ để tải số liệu thống kê.', 'error');
            });
    }

    let statusChartInstance = null;
    let priorityChartInstance = null;
    let employeeTaskChartInstance = null;

    function getPriorityGroup(p) {
        if (p === 'Cao (Gấp)' || p === 'Cao') return 'Cao';
        if (p === 'Trung bình') return 'Trung bình';
        return 'Thấp';
    }

    function getStatusGroup(s) {
        if (s === 'Hoàn thành') return 'Đã xong';
        if (s === 'Quá hạn') return 'Quá hạn';
        return 'Đang làm';
    }

    function renderCharts(tasks) {
        const total = tasks.length;
        const completed = tasks.filter(t => t.status === 'Hoàn thành').length;
        const inProgress = tasks.filter(t => t.status === 'Đang thực hiện').length;
        const overdue = tasks.filter(t => t.status === 'Quá hạn').length;
        const pending = tasks.filter(t => t.status === 'Đang chờ').length;
        const newTasks = tasks.filter(t => t.status === 'Mới tạo').length;

        const high = tasks.filter(t => t.priority === 'Cao (Gấp)' || t.priority === 'Cao').length;
        const medium = tasks.filter(t => t.priority === 'Trung bình').length;
        const low = tasks.filter(t => t.priority === 'Thấp').length;

        // Cập nhật các thẻ KPI
        document.getElementById('kpiTotal').textContent = total;
        document.getElementById('kpiCompleted').textContent = completed;
        document.getElementById('kpiInProgress').textContent = inProgress;
        document.getElementById('kpiOverdue').textContent = overdue;

        const statusCanvas = document.getElementById('statusChart');
        const noDataStatus = document.getElementById('noDataStatus');
        const priorityCanvas = document.getElementById('priorityChart');
        const noDataPriority = document.getElementById('noDataPriority');
        const empCanvas = document.getElementById('employeeTaskChart');
        const noDataEmp = document.getElementById('noDataEmployeeTask');

        if (total === 0) {
            statusCanvas.style.display = 'none';
            noDataStatus.classList.remove('d-none');
            priorityCanvas.style.display = 'none';
            noDataPriority.classList.remove('d-none');
            empCanvas.style.display = 'none';
            noDataEmp.classList.remove('d-none');

            if (statusChartInstance) statusChartInstance.destroy();
            if (priorityChartInstance) priorityChartInstance.destroy();
            if (employeeTaskChartInstance) employeeTaskChartInstance.destroy();
            return;
        } else {
            statusCanvas.style.display = 'block';
            noDataStatus.classList.add('d-none');
            priorityCanvas.style.display = 'block';
            noDataPriority.classList.add('d-none');
        }

        // Tải thiết lập màu theo theme hiện tại
        const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
        const textColor = isDark ? '#94a3b8' : '#64748b';
        const gridColor = isDark ? 'rgba(255, 255, 255, 0.08)' : '#f1f1f1';
        const borderColor = isDark ? '#1e293b' : '#ffffff';

        // Vẽ biểu đồ trạng thái (Doughnut Chart)
        if (statusChartInstance) {
            statusChartInstance.destroy();
        }
        const statusCtx = statusCanvas.getContext('2d');
        statusChartInstance = new Chart(statusCtx, {
            type: 'doughnut',
            data: {
                labels: ['Mới tạo', 'Đang thực hiện', 'Hoàn thành', 'Quá hạn', 'Đang chờ'],
                datasets: [{
                    data: [newTasks, inProgress, completed, overdue, pending],
                    backgroundColor: [
                        '#6c757d', // Mới tạo
                        '#0d6efd', // Đang thực hiện
                        '#198754', // Hoàn thành
                        '#dc3545', // Quá hạn
                        '#ffc107'  // Đang chờ
                    ],
                    borderWidth: 2,
                    borderColor: borderColor
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            boxWidth: 12,
                            padding: 15,
                            font: { family: 'system-ui, -apple-system, sans-serif', size: 12 },
                            color: textColor
                        }
                    }
                }
            }
        });

        // Vẽ biểu đồ độ ưu tiên (Bar Chart)
        if (priorityChartInstance) {
            priorityChartInstance.destroy();
        }
        const priorityCtx = priorityCanvas.getContext('2d');
        priorityChartInstance = new Chart(priorityCtx, {
            type: 'bar',
            data: {
                labels: ['Cao (Gấp)', 'Trung bình', 'Thấp'],
                datasets: [{
                    label: 'Số công việc',
                    data: [high, medium, low],
                    backgroundColor: [
                        '#dc3545',
                        '#ffc107',
                        '#0dcaf0'
                    ],
                    borderRadius: 4,
                    maxBarThickness: 35
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1, font: { family: 'system-ui' }, color: textColor },
                        grid: { color: gridColor }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { font: { family: 'system-ui' }, color: textColor }
                    }
                }
            }
        });

        // 3. Xây dựng biểu đồ cột nhóm chi tiết (employeeTaskChart)
        const deptId = document.getElementById('departmentFilter').value;
        let groups = [];
        const isDeptMode = (deptId === 'all');

        if (isDeptMode) {
            // Mode 1: Tổng quát theo Khoa/Phòng
            document.getElementById('employeeChartTitle').textContent = 'Thống kê công việc tổng quát theo Khoa/Phòng';
            document.getElementById('employeeChartSubtitle').textContent = 'Biểu đồ thể hiện mức độ và tiến độ công việc của từng Khoa/Phòng';

            const deptSelect = document.getElementById('departmentFilter');
            for (let i = 0; i < deptSelect.options.length; i++) {
                const opt = deptSelect.options[i];
                if (opt.value !== 'all') {
                    groups.push({ id: opt.value, name: opt.textContent.trim() });
                }
            }
        } else {
            // Mode 2: Chi tiết theo Nhân viên
            document.getElementById('employeeChartTitle').textContent = 'Thống kê công việc chi tiết theo Nhân viên';
            document.getElementById('employeeChartSubtitle').textContent = 'Biểu đồ thể hiện mức độ và tiến độ công việc được giao cho từng Nhân viên';

            const userSelect = document.getElementById('userFilter');
            const selectedUserId = userSelect.value;
            if (selectedUserId !== 'all') {
                const selectedOpt = userSelect.options[userSelect.selectedIndex];
                groups.push({ id: selectedUserId, name: selectedOpt.textContent.trim() });
            } else {
                for (let i = 0; i < userSelect.options.length; i++) {
                    const opt = userSelect.options[i];
                    if (opt.value !== 'all') {
                        groups.push({ id: opt.value, name: opt.textContent.trim() });
                    }
                }
            }
        }

        if (groups.length === 0) {
            empCanvas.style.display = 'none';
            noDataEmp.classList.remove('d-none');
            if (employeeTaskChartInstance) employeeTaskChartInstance.destroy();
        } else {
            empCanvas.style.display = 'block';
            noDataEmp.classList.add('d-none');

            // Khởi tạo bộ đếm cho từng nhóm
            const counts = {};
            groups.forEach(g => {
                counts[g.id] = {
                    'Thấp': { 'Đang làm': 0, 'Đã xong': 0, 'Quá hạn': 0 },
                    'Trung bình': { 'Đang làm': 0, 'Đã xong': 0, 'Quá hạn': 0 },
                    'Cao': { 'Đang làm': 0, 'Đã xong': 0, 'Quá hạn': 0 }
                };
            });

            // Phân bổ công việc vào các nhóm
            tasks.forEach(t => {
                const pGrp = getPriorityGroup(t.priority);
                const sGrp = getStatusGroup(t.status);

                if (isDeptMode) {
                    const dId = String(t.departmentId);
                    if (counts[dId]) {
                        counts[dId][pGrp][sGrp]++;
                    }
                } else {
                    if (Array.isArray(t.assignedToIds)) {
                        t.assignedToIds.forEach(uid => {
                            const uIdStr = String(uid);
                            if (counts[uIdStr]) {
                                counts[uIdStr][pGrp][sGrp]++;
                            }
                        });
                    }
                }
            });

            // Tạo dataset cho 9 trạng thái (3 mức độ x 3 tiến độ)
            const datasets = [
                // Stack 'Thấp' (Dễ)
                {
                    label: 'Đang làm (Dễ)',
                    data: groups.map(g => counts[g.id]['Thấp']['Đang làm']),
                    stack: 'Thấp',
                    backgroundColor: '#60a5fa',
                    borderRadius: 4
                },
                {
                    label: 'Đã xong (Dễ)',
                    data: groups.map(g => counts[g.id]['Thấp']['Đã xong']),
                    stack: 'Thấp',
                    backgroundColor: '#34d399',
                    borderRadius: 4
                },
                {
                    label: 'Quá hạn (Dễ)',
                    data: groups.map(g => counts[g.id]['Thấp']['Quá hạn']),
                    stack: 'Thấp',
                    backgroundColor: '#f87171',
                    borderRadius: 4
                },

                // Stack 'Trung bình'
                {
                    label: 'Đang làm (T.Bình)',
                    data: groups.map(g => counts[g.id]['Trung bình']['Đang làm']),
                    stack: 'Trung bình',
                    backgroundColor: '#2563eb',
                    borderRadius: 4
                },
                {
                    label: 'Đã xong (T.Bình)',
                    data: groups.map(g => counts[g.id]['Trung bình']['Đã xong']),
                    stack: 'Trung bình',
                    backgroundColor: '#16a34a',
                    borderRadius: 4
                },
                {
                    label: 'Quá hạn (T.Bình)',
                    data: groups.map(g => counts[g.id]['Trung bình']['Quá hạn']),
                    stack: 'Trung bình',
                    backgroundColor: '#dc2626',
                    borderRadius: 4
                },

                // Stack 'Cao' (Khó)
                {
                    label: 'Đang làm (Khó)',
                    data: groups.map(g => counts[g.id]['Cao']['Đang làm']),
                    stack: 'Cao',
                    backgroundColor: '#1e3a8a',
                    borderRadius: 4
                },
                {
                    label: 'Đã xong (Khó)',
                    data: groups.map(g => counts[g.id]['Cao']['Đã xong']),
                    stack: 'Cao',
                    backgroundColor: '#064e3b',
                    borderRadius: 4
                },
                {
                    label: 'Quá hạn (Khó)',
                    data: groups.map(g => counts[g.id]['Cao']['Quá hạn']),
                    stack: 'Cao',
                    backgroundColor: '#7f1d1d',
                    borderRadius: 4
                }
            ];

            if (employeeTaskChartInstance) {
                employeeTaskChartInstance.destroy();
            }

            const empCtx = empCanvas.getContext('2d');
            employeeTaskChartInstance = new Chart(empCtx, {
                type: 'bar',
                data: {
                    labels: groups.map(g => g.name),
                    datasets: datasets
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                boxWidth: 12,
                                padding: 15,
                                font: { family: 'system-ui, -apple-system, sans-serif', size: 11 },
                                color: textColor
                            }
                        },
                        tooltip: {
                            mode: 'index',
                            intersect: false
                        }
                    },
                    scales: {
                        y: {
                            stacked: true,
                            beginAtZero: true,
                            ticks: { stepSize: 1, font: { family: 'system-ui' }, color: textColor },
                            grid: { color: gridColor }
                        },
                        x: {
                            stacked: true,
                            grid: { display: false },
                            ticks: { font: { family: 'system-ui' }, color: textColor }
                        }
                    }
                }
            });
        }

        // Kích hoạt feather icons cho các thẻ KPI mới vẽ
        if (typeof feather !== 'undefined') {
            feather.replace();
        }
    }

    // MutationObserver để cập nhật biểu đồ trực tiếp khi thay đổi giao diện sáng/tối
    const themeObserver = new MutationObserver(() => {
        const currentDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
        const currentText = currentDark ? '#94a3b8' : '#64748b';
        const currentGrid = currentDark ? 'rgba(255, 255, 255, 0.08)' : '#f1f1f1';
        const currentBorder = currentDark ? '#1e293b' : '#ffffff';
        
        if (statusChartInstance) {
            statusChartInstance.options.plugins.legend.labels.color = currentText;
            statusChartInstance.data.datasets[0].borderColor = currentBorder;
            statusChartInstance.update();
        }
        
        if (priorityChartInstance) {
            priorityChartInstance.options.scales.x.ticks.color = currentText;
            priorityChartInstance.options.scales.y.ticks.color = currentText;
            priorityChartInstance.options.scales.y.grid.color = currentGrid;
            priorityChartInstance.update();
        }

        if (employeeTaskChartInstance) {
            employeeTaskChartInstance.options.scales.x.ticks.color = currentText;
            employeeTaskChartInstance.options.scales.y.ticks.color = currentText;
            employeeTaskChartInstance.options.scales.y.grid.color = currentGrid;
            employeeTaskChartInstance.options.plugins.legend.labels.color = currentText;
            employeeTaskChartInstance.update();
        }
    });
    themeObserver.observe(document.documentElement, { attributes: true });

    // Tự động load danh sách lúc mở trang
    document.addEventListener("DOMContentLoaded", () => {
        refreshPreview();
    });
</script>

<%- include('../partials/footer') %>
