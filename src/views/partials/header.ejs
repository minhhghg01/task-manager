<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hệ thống Quản Lý Công Việc</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/custom.css" rel="stylesheet">
</head>

<body data-userid="<%= (typeof user !== 'undefined' && user) ? user.id : '' %>">

    <header class="navbar navbar-dark sticky-top bg-primary flex-md-nowrap p-0 shadow">
        <div class="d-flex align-items-center col-md-3 col-lg-2 px-3 brand-container">
            <a class="navbar-brand me-0" href="/dashboard">Quản Lý Công Việc</a>
            <button class="btn btn-link text-white p-0 d-none d-md-inline-block ms-auto" id="toggleSidebarBtn"
                style="box-shadow: none;">
                <i data-feather="menu" style="width: 20px; height: 20px;"></i>
            </button>
        </div>

        <button class="navbar-toggler position-absolute d-md-none collapsed border-0 p-0 text-white" type="button" data-bs-toggle="collapse"
            data-bs-target="#sidebarMenu" style="box-shadow: none;">
            <i data-feather="menu" style="width: 24px; height: 24px;"></i>
        </button>

        <div class="navbar-nav px-3 d-flex flex-row align-items-center gap-3">
            <div class="nav-item text-nowrap">
                <a class="nav-link d-flex align-items-center gap-1 py-1" href="/contact" title="Liên hệ hỗ trợ">
                    <span data-feather="phone" style="width: 16px; height: 16px;"></span>
                    <span class="d-none d-md-inline small fw-semibold">Liên hệ hỗ trợ</span>
                </a>
            </div>
            <div class="nav-item text-nowrap dropdown">
                <a class="nav-link dropdown-toggle fw-bold d-flex align-items-center gap-1" href="#" id="profileDropdown" role="button"
                    data-bs-toggle="dropdown">
                    <span data-feather="user"></span>
                    <span class="d-none d-md-inline"><%= (typeof user !=='undefined' && user) ? user.fullname : 'Hồ sơ' %></span>
                </a>
                <ul class="dropdown-menu dropdown-menu-end shadow" style="min-width: 250px;">
                    <li>
                        <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#changePassModal">
                            <span data-feather="key"></span> Đổi mật khẩu
                        </a>
                    </li>

                    <li>
                        <hr class="dropdown-divider">
                    </li>

                    <li class="px-3 py-1">
                        <div class="form-check form-switch d-flex justify-content-between align-items-center ps-0">
                            <label class="form-check-label" for="darkModeSwitch">Chế độ Tối (Dark)</label>
                            <input class="form-check-input ms-2" type="checkbox" id="darkModeSwitch"
                                style="cursor: pointer;">
                        </div>
                    </li>

                    <li>
                        <hr class="dropdown-divider">
                    </li>
                    <li><a class="dropdown-item text-danger" href="/logout"><span data-feather="log-out"></span> Đăng
                            xuất</a></li>
                </ul>
            </div>
        </div>
    </header>

    <div class="container-fluid">
        <div class="row">
            <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse">
                <%- include('../partials/sidebar') %>
            </nav>

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 pt-3">

                <div class="modal fade" id="changePassModal" tabindex="-1">
                    <div class="modal-dialog">
                        <form action="/change-password" method="POST">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Đổi mật khẩu</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label>Mật khẩu hiện tại</label>
                                        <input type="password" name="currentPassword" class="form-control" required>
                                    </div>
                                    <div class="mb-3">
                                        <label>Mật khẩu mới</label>
                                        <input type="password" name="newPassword" class="form-control" required
                                            minlength="6">
                                    </div>
                                    <div class="mb-3">
                                        <label>Nhập lại mật khẩu mới</label>
                                        <input type="password" name="confirmPassword" class="form-control" required
                                            minlength="6">
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <script>
                    document.addEventListener('DOMContentLoaded', () => {
                        const html = document.documentElement;
                        const switchInput = document.getElementById('darkModeSwitch');
                        const sidebar = document.getElementById('sidebarMenu');

                        // 1. Kiểm tra LocalStorage khi load trang
                        const currentTheme = localStorage.getItem('theme');
                        if (currentTheme === 'dark') {
                            html.setAttribute('data-bs-theme', 'dark');
                            switchInput.checked = true;
                            // Chuyển sidebar sang màu tối
                            sidebar.classList.remove('bg-light');
                            sidebar.classList.add('bg-dark');
                        }

                        // 2. Xử lý sự kiện bấm nút Switch
                        switchInput.addEventListener('change', () => {
                            if (switchInput.checked) {
                                html.setAttribute('data-bs-theme', 'dark');
                                localStorage.setItem('theme', 'dark');
                                sidebar.classList.remove('bg-light');
                                sidebar.classList.add('bg-dark');
                            } else {
                                html.setAttribute('data-bs-theme', 'light');
                                localStorage.setItem('theme', 'light');
                                sidebar.classList.remove('bg-dark');
                                sidebar.classList.add('bg-light');
                            }
                        });

                        // 3. Xử lý Thu gọn Sidebar
                        const toggleBtn = document.getElementById('toggleSidebarBtn');
                        if (toggleBtn) {
                            toggleBtn.addEventListener('click', (e) => {
                                e.preventDefault();
                                document.body.classList.toggle('sidebar-collapsed');
                                const isCollapsed = document.body.classList.contains('sidebar-collapsed');
                                localStorage.setItem('sidebarCollapsed', isCollapsed ? 'true' : 'false');
                            });

                            // Khôi phục trạng thái thu gọn khi load trang
                            if (localStorage.getItem('sidebarCollapsed') === 'true') {
                                document.body.classList.add('sidebar-collapsed');
                            }
                        }

                        // 4. Xử lý Tạm ẩn Header & Footer khi cuộn chuột (Scroll Down Hide, Scroll Up Show)
                        let lastScrollTop = 0;
                        let scrollAccumulator = 0;
                        window.addEventListener('scroll', () => {
                            const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
                            const delta = scrollTop - lastScrollTop;
                            
                            if (delta > 0) {
                                // Scroll down
                                scrollAccumulator = Math.max(0, scrollAccumulator + delta);
                                if (scrollAccumulator > 15) {
                                    document.body.classList.add('scroll-down');
                                    scrollAccumulator = 0;
                                }
                            } else if (delta < 0) {
                                // Scroll up
                                scrollAccumulator = Math.min(0, scrollAccumulator + delta);
                                if (scrollAccumulator < -10) {
                                    document.body.classList.remove('scroll-down');
                                    scrollAccumulator = 0;
                                }
                            }
                            lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
                        }, { passive: true });
                    });
                </script>