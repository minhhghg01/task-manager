<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hệ thống Quản Lý Công Việc</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .sidebar {
            min-height: 100vh;
            border-right: 1px solid #dee2e6;
            transition: all 0.3s;
        }

        .navbar .dropdown-menu {
            position: absolute;
            right: 0;
            left: auto;
        }

        .navbar .nav-link {
            color: rgba(255, 255, 255, .85);
            cursor: pointer;
        }

        .navbar .nav-link:hover {
            color: #fff;
        }

        /* --- COLLAPSED SIDEBAR FOR DESKTOP --- */
        @media (min-width: 768px) {
            .brand-container {
                transition: all 0.3s ease;
            }
            .sidebar {
                transition: all 0.3s ease;
            }
            main {
                transition: all 0.3s ease;
            }

            body.sidebar-collapsed .brand-container {
                width: 70px !important;
                max-width: 70px !important;
                flex: 0 0 70px !important;
                padding-left: 0 !important;
                padding-right: 0 !important;
                justify-content: center !important;
            }
            body.sidebar-collapsed .brand-container a.navbar-brand {
                display: none !important;
            }
            body.sidebar-collapsed .brand-container #toggleSidebarBtn {
                margin-left: 0 !important;
            }

            body.sidebar-collapsed #sidebarMenu {
                width: 70px !important;
                max-width: 70px !important;
                flex: 0 0 70px !important;
            }
            body.sidebar-collapsed main {
                width: calc(100% - 70px) !important;
                max-width: calc(100% - 70px) !important;
                flex: 0 0 calc(100% - 70px) !important;
                margin-left: 0 !important;
            }
            body.sidebar-collapsed #sidebarMenu .sidebar-heading {
                display: none !important;
            }
            body.sidebar-collapsed #sidebarMenu .nav-link {
                text-align: center;
                padding: 10px 0;
                font-size: 0 !important;
            }
            body.sidebar-collapsed #sidebarMenu .nav-link span {
                display: none !important;
            }
            body.sidebar-collapsed #sidebarMenu .nav-link span[data-feather] {
                display: inline-block !important;
                margin-right: 0 !important;
                width: 20px;
                height: 20px;
            }
        }

        /* --- SCROLL SHOW/HIDE ANIMATION FOR HEADER & FOOTER --- */
        header.navbar {
            transition: transform 0.3s ease, background-color 0.3s ease !important;
        }
        .fixed-bottom-footer {
            transition: transform 0.3s ease, background-color 0.3s ease !important;
        }
        body.scroll-down header.navbar {
            transform: translateY(-100%);
        }
        body.scroll-down .fixed-bottom-footer {
            transform: translateY(100%);
        }

        /* --- MOBILE GENERAL OPTIMIZATIONS --- */
        @media (max-width: 767.98px) {
            .table {
                display: block;
                width: 100%;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }
            .container-fluid {
                padding-left: 8px !important;
                padding-right: 8px !important;
            }
            main {
                padding-left: 8px !important;
                padding-right: 8px !important;
                padding-top: 15px !important;
            }
        }
    </style>
</head>

<body data-userid="<%= (typeof user !== 'undefined' && user) ? user.id : '' %>">

    <header class="navbar navbar-dark sticky-top bg-primary flex-md-nowrap p-0 shadow">
        <div class="d-flex align-items-center col-md-3 col-lg-2 px-3 brand-container">
            <a class="navbar-brand me-0" href="/dashboard">Quản Lý Công Việc</a>
            <button class="btn btn-link text-white p-0 d-none d-md-inline-block ms-auto" id="toggleSidebarBtn" style="box-shadow: none;">
                <i data-feather="menu" style="width: 20px; height: 20px;"></i>
            </button>
        </div>

        <button class="navbar-toggler position-absolute d-md-none collapsed" type="button" data-bs-toggle="collapse"
            data-bs-target="#sidebarMenu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="navbar-nav px-3 d-flex flex-row align-items-center gap-3">
            <div class="nav-item text-nowrap">
                <a class="nav-link d-flex align-items-center gap-1 py-1" href="/contact" title="Liên hệ hỗ trợ">
                    <span data-feather="phone" style="width: 16px; height: 16px;"></span>
                    <span class="d-none d-md-inline small fw-semibold">Liên hệ hỗ trợ</span>
                </a>
            </div>
            <div class="nav-item text-nowrap dropdown">
                <a class="nav-link dropdown-toggle fw-bold" href="#" id="profileDropdown" role="button"
                    data-bs-toggle="dropdown">
                    <span data-feather="user"></span>
                    <%= (typeof user !=='undefined' && user) ? user.fullname : 'Hồ sơ' %>
                </a>
                <ul class="dropdown-menu dropdown-menu-end shadow" style="min-width: 250px;">
                    <li>
                        <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#changePassModal">
                            <span data-feather="key"></span> Đổi mật khẩu
                        </a>
                    </li>

                    <li>
                        <hr class="dropdown-divider">
                    </li>

                    <li class="px-3 py-1">
                        <div class="form-check form-switch d-flex justify-content-between align-items-center ps-0">
                            <label class="form-check-label" for="darkModeSwitch">Chế độ Tối (Dark)</label>
                            <input class="form-check-input ms-2" type="checkbox" id="darkModeSwitch"
                                style="cursor: pointer;">
                        </div>
                    </li>

                    <li>
                        <hr class="dropdown-divider">
                    </li>
                    <li><a class="dropdown-item text-danger" href="/logout"><span data-feather="log-out"></span> Đăng
                            xuất</a></li>
                </ul>
            </div>
        </div>
    </header>

    <div class="container-fluid">
        <div class="row">
            <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse">
                <%- include('../partials/sidebar') %>
            </nav>

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 pt-3">

                <div class="modal fade" id="changePassModal" tabindex="-1">
                    <div class="modal-dialog">
                        <form action="/change-password" method="POST">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Đổi mật khẩu</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label>Mật khẩu hiện tại</label>
                                        <input type="password" name="currentPassword" class="form-control" required>
                                    </div>
                                    <div class="mb-3">
                                        <label>Mật khẩu mới</label>
                                        <input type="password" name="newPassword" class="form-control" required
                                            minlength="6">
                                    </div>
                                    <div class="mb-3">
                                        <label>Nhập lại mật khẩu mới</label>
                                        <input type="password" name="confirmPassword" class="form-control" required
                                            minlength="6">
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <script>
                    document.addEventListener('DOMContentLoaded', () => {
                        const html = document.documentElement;
                        const switchInput = document.getElementById('darkModeSwitch');
                        const sidebar = document.getElementById('sidebarMenu');

                        // 1. Kiểm tra LocalStorage khi load trang
                        const currentTheme = localStorage.getItem('theme');
                        if (currentTheme === 'dark') {
                            html.setAttribute('data-bs-theme', 'dark');
                            switchInput.checked = true;
                            // Chuyển sidebar sang màu tối
                            sidebar.classList.remove('bg-light');
                            sidebar.classList.add('bg-dark');
                        }

                        // 2. Xử lý sự kiện bấm nút Switch
                        switchInput.addEventListener('change', () => {
                            if (switchInput.checked) {
                                html.setAttribute('data-bs-theme', 'dark');
                                localStorage.setItem('theme', 'dark');
                                sidebar.classList.remove('bg-light');
                                sidebar.classList.add('bg-dark');
                            } else {
                                html.setAttribute('data-bs-theme', 'light');
                                localStorage.setItem('theme', 'light');
                                sidebar.classList.remove('bg-dark');
                                sidebar.classList.add('bg-light');
                            }
                        });

                        // 3. Xử lý Thu gọn Sidebar
                        const toggleBtn = document.getElementById('toggleSidebarBtn');
                        if (toggleBtn) {
                            toggleBtn.addEventListener('click', (e) => {
                                e.preventDefault();
                                document.body.classList.toggle('sidebar-collapsed');
                                const isCollapsed = document.body.classList.contains('sidebar-collapsed');
                                localStorage.setItem('sidebarCollapsed', isCollapsed ? 'true' : 'false');
                            });
                            
                            // Khôi phục trạng thái thu gọn khi load trang
                            if (localStorage.getItem('sidebarCollapsed') === 'true') {
                                document.body.classList.add('sidebar-collapsed');
                            }
                        }

                        // 4. Xử lý Tạm ẩn Header & Footer khi cuộn chuột (Scroll Down Hide, Scroll Up Show)
                        let lastScrollTop = 0;
                        window.addEventListener('scroll', () => {
                            const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
                            if (scrollTop > lastScrollTop && scrollTop > 100) {
                                document.body.classList.add('scroll-down');
                            } else if (scrollTop < lastScrollTop) {
                                document.body.classList.remove('scroll-down');
                            }
                            lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
                        }, { passive: true });
                    });
                </script>