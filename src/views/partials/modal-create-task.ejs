<div class="modal fade" id="createTaskModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">

        <form action="/api/tasks" method="POST" enctype="multipart/form-data" id="createTaskForm">
            <div class="modal-content">

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <span data-feather="plus-circle" style="width: 20px"></span> Giao việc mới
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <!-- Khu vực chọn mẫu nhanh -->
                    <div class="mb-3 p-3 bg-light border rounded">
                        <label class="form-label fw-bold text-primary d-flex align-items-center gap-1">
                            <span data-feather="file-text" style="width: 18px; height: 18px;"></span> Chọn mẫu công việc nhanh
                        </label>
                        <div class="row g-2 align-items-center">
                            <div class="col-md-6 d-flex gap-2">
                                <select id="templateSelect" class="form-select">
                                    <option value="">-- Chọn mẫu công việc nhanh (Hoặc tự nhập) --</option>
                                </select>
                                <button type="button" id="btnDeleteTemplate" class="btn btn-outline-danger btn-sm" title="Xóa mẫu đang chọn" style="display: none;">
                                    <span data-feather="trash-2" style="width: 16px; height: 16px;"></span>
                                </button>
                            </div>
                            <div class="col-md-6">
                                <div class="input-group">
                                    <input type="text" id="templateNameInput" class="form-control form-control-sm" placeholder="Nhập tên mẫu mới...">
                                    <button type="button" id="btnSaveAsTemplate" class="btn btn-outline-primary btn-sm">
                                        <span data-feather="save" style="width: 16px; height: 16px;"></span> Lưu mẫu mới
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label class="form-label fw-bold">Tiêu đề công việc <span
                                    class="text-danger">*</span></label>
                            <input type="text" name="title" class="form-control" required
                                placeholder="Nhập tên công việc ngắn gọn...">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">Độ ưu tiên</label>
                            <select name="priority" class="form-select">
                                <option value="Trung bình" selected>Trung bình</option>
                                <option value="Cao (Gấp)" class="text-danger fw-bold">Cao (Gấp)</option>
                                <option value="Thấp">Thấp</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Thẻ (Tags)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i data-feather="tag"></i></span>
                                <input type="text" name="tags" class="form-control" list="datalistOptions"
                                    placeholder="Nhập thẻ... (Ví dụ: Marketing, Gấp, Dự án A)">

                                <datalist id="datalistOptions">
                                    <% if (typeof suggestedTags !=='undefined' && suggestedTags.length> 0) { %>
                                        <% suggestedTags.forEach(tag=> { %>
                                            <option value="<%= tag %>">
                                                <% }) %>
                                                    <% } %>
                                </datalist>
                            </div>
                            <div class="form-text">Nhập để phân loại công việc, không bắt buộc.</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mô tả chi tiết</label>
                        <textarea name="description" class="form-control" rows="3"
                            placeholder="Mô tả nội dung, yêu cầu cụ thể..."></textarea>
                    </div>

                    <div class="row bg-light p-2 rounded mb-3 border mx-0">
                        <div class="col-md-6 mb-2">
                            <label class="form-label fw-bold text-primary">Ngày bắt đầu</label>
                            <input type="datetime-local" name="start_date" id="startDateInput" class="form-control">
                            <div class="form-text small">Mặc định là thời điểm hiện tại.</div>
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="form-label fw-bold text-danger">Hạn chót (Deadline)</label>
                            <input type="datetime-local" name="due_date" id="dueDateInput" class="form-control">
                            <div class="form-text small">Bỏ trống nếu không giới hạn thời gian.</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            <span data-feather="paperclip" style="width: 16px"></span> Đính kèm tài liệu
                        </label>
                        <input type="file" name="attachment" class="form-control"
                            accept=".jpg, .jpeg, .png, .gif, .txt, .pdf, .doc, .docx, .xls, .xlsx, .ppt, .pptx">
                        <small class="text-muted fst-italic">Hỗ trợ: Ảnh, Word, Excel, PowerPoint, PDF, TXT (Max
                            10MB).</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Người nhận việc <span class="text-danger">*</span></label>

                        <div class="card p-2" style="background-color: #f8f9fa;">

                            <div class="form-check border-bottom pb-2 mb-2 bg-white p-2 rounded border">
                                <input class="form-check-input" type="checkbox" id="selfAssignCheck"
                                    name="is_self_assign" value="true">
                                <label class="form-check-label fw-bold text-success" for="selfAssignCheck">
                                    <span data-feather="user-check" style="width: 16px;"></span> Tôi tự thực hiện công
                                    việc này
                                </label>
                            </div>

                            <div class="form-check border-bottom pb-2 mb-2">
                                <input class="form-check-input" type="checkbox" id="selectAllUsers">
                                <label class="form-check-label fw-bold text-primary" for="selectAllUsers">
                                    Chọn tất cả nhân viên
                                </label>
                            </div>

                            <div id="userListContainer" style="max-height: 200px; overflow-y: auto;">
                                <div class="text-center text-muted py-3">
                                    <div class="spinner-border spinner-border-sm" role="status"></div> Đang tải danh
                                    sách...
                                </div>
                            </div>
                        </div>
                        <small class="text-muted">Có thể chọn nhiều người cùng lúc.</small>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-success fw-bold">
                        <span data-feather="send" style="width: 16px"></span> Giao việc ngay
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const modal = document.getElementById('createTaskModal');
        const listContainer = document.getElementById('userListContainer');
        const selectAllCheckbox = document.getElementById('selectAllUsers');
        const form = document.getElementById('createTaskForm');

        // Element checkbox tự giao việc
        const selfAssignCheck = document.getElementById('selfAssignCheck');

        // Các input thời gian
        const startDateInput = document.getElementById('startDateInput');
        const dueDateInput = document.getElementById('dueDateInput');

        let preSelectUserId = null;

        // --- XỬ LÝ MẪU CÔNG VIỆC CHUNG (TEMPLATE) ---
        const templateSelect = document.getElementById('templateSelect');
        const btnDeleteTemplate = document.getElementById('btnDeleteTemplate');
        const btnSaveAsTemplate = document.getElementById('btnSaveAsTemplate');

        let loadedTemplates = [];

        function loadTemplates(selectedId = null) {
            if (!templateSelect) return;
            fetch('/api/templates')
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        loadedTemplates = data.templates || [];
                        templateSelect.innerHTML = '<option value="">-- Chọn mẫu công việc nhanh (Hoặc tự nhập) --</option>';
                        loadedTemplates.forEach(t => {
                            const option = document.createElement('option');
                            option.value = t.id;
                            option.textContent = t.name;
                            templateSelect.appendChild(option);
                        });
                        
                        if (selectedId) {
                            templateSelect.value = selectedId;
                            templateSelect.dispatchEvent(new Event('change'));
                        } else {
                            if (btnDeleteTemplate) btnDeleteTemplate.style.display = 'none';
                        }
                        if (typeof feather !== 'undefined') feather.replace();
                    }
                })
                .catch(err => console.error("Lỗi tải mẫu:", err));
        }

        if (templateSelect) {
            templateSelect.addEventListener('change', function () {
                const val = this.value;
                if (!val) {
                    if (btnDeleteTemplate) btnDeleteTemplate.style.display = 'none';
                    return;
                }

                const selected = loadedTemplates.find(t => String(t.id) === String(val));
                if (selected) {
                    const titleInput = form.querySelector('input[name="title"]');
                    const descInput = form.querySelector('textarea[name="description"]');
                    const priorityInput = form.querySelector('select[name="priority"]');
                    const tagsInput = form.querySelector('input[name="tags"]');

                    if (titleInput) titleInput.value = selected.title || '';
                    if (descInput) descInput.value = selected.description || '';
                    if (priorityInput) priorityInput.value = selected.priority || 'Trung bình';
                    if (tagsInput) tagsInput.value = selected.tags || '';

                    // Kiểm tra xem user hiện tại là người tạo hoặc admin để hiện nút xóa
                    const currentUserId = '<%= user.id %>';
                    const currentUserRole = '<%= user.role %>';
                    if (currentUserRole === 'ADMIN' || String(selected.created_by) === String(currentUserId)) {
                        if (btnDeleteTemplate) btnDeleteTemplate.style.display = 'block';
                    } else {
                        if (btnDeleteTemplate) btnDeleteTemplate.style.display = 'none';
                    }
                }
            });
        }

        if (btnSaveAsTemplate) {
            btnSaveAsTemplate.addEventListener('click', function () {
                const titleInput = form.querySelector('input[name="title"]');
                const descInput = form.querySelector('textarea[name="description"]');
                const priorityInput = form.querySelector('select[name="priority"]');
                const tagsInput = form.querySelector('input[name="tags"]');
                const templateNameInput = document.getElementById('templateNameInput');

                const titleVal = titleInput ? titleInput.value.trim() : '';
                if (!titleVal) {
                    alert('Vui lòng nhập Tiêu đề công việc trước khi lưu thành Mẫu!');
                    if (titleInput) titleInput.focus();
                    return;
                }

                const templateName = templateNameInput ? templateNameInput.value.trim() : '';
                if (!templateName) {
                    alert('Vui lòng nhập tên gợi nhớ cho Mẫu công việc trước khi lưu!');
                    if (templateNameInput) templateNameInput.focus();
                    return;
                }

                const bodyData = {
                    name: templateName,
                    title: titleVal,
                    description: descInput ? descInput.value.trim() : '',
                    priority: priorityInput ? priorityInput.value : 'Trung bình',
                    tags: tagsInput ? tagsInput.value.trim() : ''
                };

                fetch('/api/templates', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(bodyData)
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        alert(data.message);
                        if (templateNameInput) templateNameInput.value = '';
                        loadTemplates(data.template.id);
                    } else {
                        alert('Lỗi: ' + data.message);
                    }
                })
                .catch(err => {
                    console.error(err);
                    alert('Lỗi kết nối máy chủ!');
                });
            });
        }

        if (btnDeleteTemplate) {
            btnDeleteTemplate.addEventListener('click', function () {
                const val = templateSelect.value;
                if (!val) return;

                if (!confirm('Bạn có chắc chắn muốn xóa mẫu công việc này?')) return;

                fetch(`/api/templates/${val}`, { method: 'DELETE' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        alert(data.message);
                        loadTemplates();
                    } else {
                        alert('Lỗi: ' + data.message);
                    }
                })
                .catch(err => {
                    console.error(err);
                    alert('Lỗi kết nối máy chủ!');
                });
            });
        }

        // 1. KHI MỞ MODAL
        modal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;

            // Xóa dữ liệu copy nếu mở từ nút bình thường
            if (event && event.relatedTarget) {
                window.copyTaskData = null;
                window.copyTaskAssignedTo = null;
            }

            preSelectUserId = button ? button.getAttribute('data-preselect') : null;
            const isAutoSelf = button ? button.getAttribute('data-auto-self') === 'true' : false;

            // Reset trạng thái ban đầu
            if (selectAllCheckbox) {
                selectAllCheckbox.checked = false;
                selectAllCheckbox.disabled = false;
            }
            if (selfAssignCheck) {
                selfAssignCheck.checked = false;
            }
            listContainer.style.opacity = '1';
            listContainer.style.pointerEvents = 'auto';

            // Tải danh sách mẫu
            loadTemplates();

            // --- LOGIC TỰ ĐỘNG TICK "TÔI TỰ LÀM" ---
            if (isAutoSelf && selfAssignCheck) {
                selfAssignCheck.checked = true;
                selfAssignCheck.dispatchEvent(new Event('change'));
            }

            // --- LOGIC THỜI GIAN ---
            const now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            const currentDateTime = now.toISOString().slice(0, 16);

            // Tự nhập deadline là 23:59:59 today()
            const todayEnd = new Date();
            todayEnd.setHours(23, 59, 59, 999);
            const y = todayEnd.getFullYear();
            const m = String(todayEnd.getMonth() + 1).padStart(2, '0');
            const d = String(todayEnd.getDate()).padStart(2, '0');
            const h = String(todayEnd.getHours()).padStart(2, '0');
            const min = String(todayEnd.getMinutes()).padStart(2, '0');
            const defaultDueDate = `${y}-${m}-${d}T${h}:${min}`;

            if (startDateInput) {
                startDateInput.value = currentDateTime;
                startDateInput.min = currentDateTime;
            }
            if (dueDateInput) {
                dueDateInput.value = defaultDueDate;
                dueDateInput.min = currentDateTime;
            }

            // --- XỬ LÝ ĐIỀN THÔNG TIN SAO CHÉP (COPY) ---
            const titleInput = form.querySelector('input[name="title"]');
            const descInput = form.querySelector('textarea[name="description"]');
            const priorityInput = form.querySelector('select[name="priority"]');
            const tagsInput = form.querySelector('input[name="tags"]');

            if (window.copyTaskData) {
                const data = window.copyTaskData;
                if (titleInput) titleInput.value = data.title || '';
                if (descInput) descInput.value = data.description || '';
                if (priorityInput) priorityInput.value = data.priority || 'Trung bình';
                if (tagsInput) tagsInput.value = data.tags || '';

                const currentUserId = '<%= user.id %>';
                const assigneeIds = data.assignedTo || [];
                const isSelf = assigneeIds.map(String).includes(String(currentUserId));

                if (isSelf && selfAssignCheck) {
                    selfAssignCheck.checked = true;
                    selfAssignCheck.dispatchEvent(new Event('change'));
                } else if (selfAssignCheck) {
                    selfAssignCheck.checked = false;
                    selfAssignCheck.dispatchEvent(new Event('change'));
                }

                window.copyTaskAssignedTo = assigneeIds;
            } else {
                if (titleInput && !isAutoSelf) titleInput.value = '';
                if (descInput && !isAutoSelf) descInput.value = '';
                if (priorityInput && !isAutoSelf) priorityInput.value = 'Trung bình';
                if (tagsInput && !isAutoSelf) tagsInput.value = '';
                window.copyTaskAssignedTo = null;
            }

            loadUsers();
        });

        // 2. XỬ LÝ KHI CHỌN "TÔI TỰ LÀM"
        if (selfAssignCheck) {
            selfAssignCheck.addEventListener('change', function () {
                const isSelf = this.checked;

                // Khóa/Mở nút chọn tất cả
                if (selectAllCheckbox) selectAllCheckbox.disabled = isSelf;
                if (isSelf && selectAllCheckbox) selectAllCheckbox.checked = false;

                // Khóa/Mở danh sách user
                const checkboxes = listContainer.querySelectorAll('.user-checkbox');
                checkboxes.forEach(cb => {
                    cb.disabled = isSelf;
                    if (isSelf) cb.checked = false;
                });

                // Hiệu ứng mờ đi
                if (isSelf) {
                    listContainer.style.opacity = '0.5';
                    listContainer.style.pointerEvents = 'none';
                } else {
                    listContainer.style.opacity = '1';
                    listContainer.style.pointerEvents = 'auto';
                }
            });
        }

        // 3. HÀM LOAD USER
        function loadUsers() {
            listContainer.innerHTML = '<div class="text-center text-muted py-3"><div class="spinner-border spinner-border-sm"></div> Đang tải...</div>';

            fetch('/api/users/subordinates')
                .then(res => res.json())
                .then(data => {
                    listContainer.innerHTML = '';

                    if (data.users && data.users.length > 0) {
                        data.users.forEach(u => {
                            const isSelfMode = selfAssignCheck ? selfAssignCheck.checked : false;
                            const disabledAttr = isSelfMode ? 'disabled' : '';

                            // Check nếu thuộc danh sách được chọn (bao gồm trường hợp copy hoặc pre-select)
                            let isChecked = false;
                            if (preSelectUserId && String(preSelectUserId) === String(u.id)) {
                                isChecked = true;
                            } else if (window.copyTaskAssignedTo && window.copyTaskAssignedTo.map(String).includes(String(u.id))) {
                                isChecked = true;
                            }

                            const checkedAttr = isChecked ? 'checked' : '';
                            const bgClass = isChecked ? 'bg-warning bg-opacity-10' : 'bg-white';

                            const div = document.createElement('div');
                            div.className = `d-flex align-items-center mb-1 p-2 border rounded ${bgClass}`;

                            div.innerHTML = `
                                <div class="me-2">
                                    <input class="form-check-input user-checkbox" type="checkbox" 
                                           name="assigned_to" value="${u.id}" id="user_${u.id}" ${checkedAttr} ${disabledAttr}
                                           style="width: 1.2em; height: 1.2em; cursor: pointer;">
                                </div>
                                <label class="flex-grow-1 mb-0" style="cursor:pointer; user-select: none;" for="user_${u.id}">
                                    <strong>${u.fullname}</strong> 
                                    <span class="badge bg-secondary ms-1" style="font-size: 0.7em">${u.role}</span>
                                </label>
                            `;
                            listContainer.appendChild(div);
                        });
                        if (typeof feather !== 'undefined') feather.replace();
                    } else {
                        listContainer.innerHTML = '<p class="text-muted text-center mb-0 small">Bạn chưa có nhân viên cấp dưới.</p>';
                    }
                })
                .catch(err => {
                    console.error(err);
                    listContainer.innerHTML = '<p class="text-danger text-center">Lỗi tải dữ liệu.</p>';
                });
        }

        // 4. XỬ LÝ CHỌN TẤT CẢ
        if (selectAllCheckbox) {
            selectAllCheckbox.addEventListener('change', function () {
                const checkboxes = document.querySelectorAll('.user-checkbox');
                checkboxes.forEach(cb => cb.checked = this.checked);
            });
        }

        // 5. XỬ LÝ SUBMIT BẰNG AJAX
        if (form) {
            form.addEventListener('submit', async function (e) {
                e.preventDefault();

                const btnSubmit = form.querySelector('button[type="submit"]');
                const originalBtnText = btnSubmit.innerHTML;

                const isSelf = selfAssignCheck ? selfAssignCheck.checked : false;
                const checked = document.querySelectorAll('.user-checkbox:checked');

                if (!isSelf && checked.length === 0) {
                    alert('Vui lòng chọn ít nhất một người nhận việc (hoặc chọn "Tôi tự thực hiện")!');
                    const target = document.querySelector('.card.p-2');
                    if (target) {
                        target.scrollIntoView({ behavior: 'smooth' });
                        target.classList.add('border', 'border-danger');
                        setTimeout(() => target.classList.remove('border-danger'), 2000);
                    }
                    return;
                }

                try {
                    btnSubmit.disabled = true;
                    btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang xử lý...';

                    const formData = new FormData(this);

                    const response = await fetch('/api/tasks', {
                        method: 'POST',
                        body: formData
                    });

                    const result = await response.json();

                    if (result.success) {
                        window.location.reload();
                    } else {
                        alert(result.message || 'Có lỗi xảy ra!');
                    }

                } catch (err) {
                    console.error(err);
                    alert('Lỗi kết nối đến máy chủ!');
                } finally {
                    btnSubmit.disabled = false;
                    btnSubmit.innerHTML = originalBtnText;
                }
            });
        }
    });
</script>