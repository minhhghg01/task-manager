<div class="modal fade" id="createTaskModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">

        <form action="/api/tasks" method="POST" enctype="multipart/form-data" id="createTaskForm">
            <div class="modal-content">

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <span data-feather="plus-circle" style="width: 20px"></span> Giao việc mới
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <!-- Khu vực chọn mẫu nhanh -->
                    <div class="mb-3 p-3 bg-light border rounded">
                        <label class="form-label fw-bold text-primary d-flex align-items-center gap-1">
                            <span data-feather="file-text" style="width: 18px; height: 18px;"></span> Chọn mẫu công việc nhanh
                        </label>
                        <div class="row g-3 align-items-center mb-2">
                            <div class="col-md-6 d-flex gap-2">
                                <select id="templateSelect" class="form-select">
                                    <option value="">-- Chọn mẫu công việc nhanh (Hoặc tự nhập) --</option>
                                </select>
                                <button type="button" id="btnDeleteTemplate" class="btn btn-outline-danger btn-sm" title="Xóa mẫu đang chọn" style="display: none;">
                                    <span data-feather="trash-2" style="width: 16px; height: 16px;"></span>
                                </button>
                            </div>
                            <div class="col-md-6">
                                <input type="text" id="templateNameInput" class="form-control form-control-sm" placeholder="Nhập tên mẫu mới để lưu...">
                            </div>
                        </div>
                        <div class="row g-2 align-items-center">
                            <div class="col-md-8 d-flex align-items-center gap-3">
                                <span class="small fw-bold text-muted">Chia sẻ mẫu:</span>
                                <div class="form-check form-check-inline mb-0">
                                    <input class="form-check-input" type="radio" name="shareLevel" id="sharePrivate" value="PRIVATE" checked>
                                    <label class="form-check-label small" for="sharePrivate">Riêng tôi</label>
                                </div>
                                <div class="form-check form-check-inline mb-0">
                                    <input class="form-check-input" type="radio" name="shareLevel" id="shareDept" value="DEPARTMENT">
                                    <label class="form-check-label small" for="shareDept">Khoa phòng</label>
                                </div>
                                <div class="form-check form-check-inline mb-0">
                                    <input class="form-check-input" type="radio" name="shareLevel" id="shareGlobal" value="GLOBAL">
                                    <label class="form-check-label small" for="shareGlobal">Toàn bộ</label>
                                </div>
                            </div>
                            <div class="col-md-4 text-end">
                                <button type="button" id="btnSaveAsTemplate" class="btn btn-primary btn-sm w-100">
                                    <span data-feather="save" style="width: 16px; height: 16px;"></span> Lưu mẫu công việc
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label class="form-label fw-bold">Tiêu đề công việc <span
                                    class="text-danger">*</span></label>
                            <input type="text" name="title" class="form-control" required
                                placeholder="Nhập tên công việc ngắn gọn...">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">Độ ưu tiên</label>
                            <select name="priority" class="form-select">
                                <option value="Trung bình" selected>Trung bình</option>
                                <option value="Cao (Gấp)" class="text-danger fw-bold">Cao (Gấp)</option>
                                <option value="Thấp">Thấp</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Thẻ (Tags)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i data-feather="tag"></i></span>
                                <input type="text" name="tags" class="form-control" list="datalistOptions"
                                    placeholder="Nhập thẻ... (Ví dụ: Marketing, Gấp, Dự án A)">

                                <datalist id="datalistOptions">
                                    <% if (typeof suggestedTags !=='undefined' && suggestedTags.length> 0) { %>
                                        <% suggestedTags.forEach(tag=> { %>
                                            <option value="<%= tag %>">
                                                <% }) %>
                                                    <% } %>
                                </datalist>
                            </div>
                            <div class="form-text">Nhập để phân loại công việc, không bắt buộc.</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mô tả chi tiết</label>
                        <textarea name="description" class="form-control" rows="3"
                            placeholder="Mô tả nội dung, yêu cầu cụ thể..."></textarea>
                    </div>

                    <div class="row bg-light p-2 rounded mb-3 border mx-0">
                        <div class="col-md-6 mb-2">
                            <label class="form-label fw-bold text-primary">Ngày bắt đầu</label>
                            <input type="datetime-local" name="start_date" id="startDateInput" class="form-control" step="1">
                            <div class="form-text small">Mặc định là thời điểm hiện tại.</div>
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="form-label fw-bold text-danger">Hạn chót (Deadline)</label>
                            <input type="datetime-local" name="due_date" id="dueDateInput" class="form-control" step="1">
                            <div class="form-text small">Bỏ trống nếu không giới hạn thời gian.</div>
                        </div>
                    </div>

                    <!-- CẤU HÌNH LẶP LẠI (RECURRING TASK) -->
                    <div class="row bg-light p-2 rounded mb-3 border mx-0">
                        <div class="col-md-12 mb-2">
                            <label class="form-label fw-bold d-flex align-items-center gap-1">
                                <span data-feather="repeat" style="width: 16px; height: 16px;"></span> Thiết lập lặp lại công việc
                            </label>
                            <select name="recurrence" id="recurrenceSelect" class="form-select">
                                <option value="none" selected>Không lặp</option>
                                <option value="daily">Hàng ngày</option>
                                <option value="weekly">Hàng tuần (Tùy chỉnh thứ)</option>
                                <option value="monthly">Hàng tháng</option>
                            </select>
                        </div>
                        <div class="col-md-12 mb-2 mt-2" id="weeklyDaysContainer" style="display: none;">
                            <label class="form-label small fw-bold text-muted d-block">Chọn các ngày lặp lại trong tuần:</label>
                            <div class="d-flex flex-wrap gap-2 py-1">
                                <div class="form-check form-check-inline border rounded p-2 d-flex align-items-center gap-1">
                                    <input class="form-check-input ms-0" type="checkbox" name="recurrence_days" id="day_mon" value="1">
                                    <label class="form-check-label small fw-bold text-secondary" for="day_mon">Thứ 2</label>
                                </div>
                                <div class="form-check form-check-inline border rounded p-2 d-flex align-items-center gap-1">
                                    <input class="form-check-input ms-0" type="checkbox" name="recurrence_days" id="day_tue" value="2">
                                    <label class="form-check-label small fw-bold text-secondary" for="day_tue">Thứ 3</label>
                                </div>
                                <div class="form-check form-check-inline border rounded p-2 d-flex align-items-center gap-1">
                                    <input class="form-check-input ms-0" type="checkbox" name="recurrence_days" id="day_wed" value="3">
                                    <label class="form-check-label small fw-bold text-secondary" for="day_wed">Thứ 4</label>
                                </div>
                                <div class="form-check form-check-inline border rounded p-2 d-flex align-items-center gap-1">
                                    <input class="form-check-input ms-0" type="checkbox" name="recurrence_days" id="day_thu" value="4">
                                    <label class="form-check-label small fw-bold text-secondary" for="day_thu">Thứ 5</label>
                                </div>
                                <div class="form-check form-check-inline border rounded p-2 d-flex align-items-center gap-1">
                                    <input class="form-check-input ms-0" type="checkbox" name="recurrence_days" id="day_fri" value="5">
                                    <label class="form-check-label small fw-bold text-secondary" for="day_fri">Thứ 6</label>
                                </div>
                                <div class="form-check form-check-inline border rounded p-2 d-flex align-items-center gap-1">
                                    <input class="form-check-input ms-0" type="checkbox" name="recurrence_days" id="day_sat" value="6">
                                    <label class="form-check-label small fw-bold text-secondary" for="day_sat">Thứ 7</label>
                                </div>
                                <div class="form-check form-check-inline border rounded p-2 d-flex align-items-center gap-1">
                                    <input class="form-check-input ms-0" type="checkbox" name="recurrence_days" id="day_sun" value="0">
                                    <label class="form-check-label small fw-bold text-secondary" for="day_sun">Chủ Nhật</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12 mb-2 mt-2" id="monthlyDayContainer" style="display: none;">
                            <label class="form-label small fw-bold text-muted d-block">Chọn ngày lặp lại trong tháng:</label>
                            <div class="monthly-days-grid mb-2">
                                <% for (let i = 1; i <= 31; i++) { %>
                                    <div class="monthly-day-item">
                                        <input type="checkbox" name="recurrence_days" id="create_monthly_day_<%= i %>" value="<%= i %>" class="btn-check" autocomplete="off">
                                        <label for="create_monthly_day_<%= i %>"><%= i %></label>
                                    </div>
                                <% } %>
                            </div>
                            <small class="text-muted d-block mt-1 fst-italic">Nếu tháng không có ngày được chọn (ví dụ ngày 31 ở tháng 2), hệ thống sẽ lùi về ngày cuối cùng của tháng đó.</small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            <span data-feather="paperclip" style="width: 16px"></span> Đính kèm tài liệu
                        </label>
                        <input type="file" name="attachment" class="form-control"
                            accept=".jpg, .jpeg, .png, .gif, .txt, .pdf, .doc, .docx, .xls, .xlsx, .ppt, .pptx">
                        <small class="text-muted fst-italic">Hỗ trợ: Ảnh, Word, Excel, PowerPoint, PDF, TXT (Max
                            10MB).</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Người nhận việc <span class="text-danger">*</span></label>

                        <div class="card p-2 user-list-wrapper">

                            <div class="d-flex align-items-center mb-2 p-2 border rounded self-assign-box bg-light-subtle" style="cursor: pointer;">
                                <div class="me-2">
                                    <input class="form-check-input ms-0" type="checkbox" id="selfAssignCheck"
                                           name="is_self_assign" value="true"
                                           style="width: 1.2em; height: 1.2em; cursor: pointer; margin-top: 0;">
                                </div>
                                <label class="flex-grow-1 mb-0 fw-bold text-success d-flex align-items-center gap-1" style="cursor:pointer; user-select: none;" for="selfAssignCheck">
                                    <span data-feather="user-check" style="width: 16px;"></span> Tôi tự thực hiện công việc này
                                </label>
                            </div>

                            <div class="form-check border-bottom pb-2 mb-2">
                                <input class="form-check-input" type="checkbox" id="selectAllUsers">
                                <label class="form-check-label fw-bold text-primary" for="selectAllUsers">
                                    Chọn tất cả nhân viên
                                </label>
                            </div>

                            <div id="userListContainer" style="max-height: 200px; overflow-y: auto;">
                                <div class="text-center text-muted py-3">
                                    <div class="spinner-border spinner-border-sm" role="status"></div> Đang tải danh
                                    sách...
                                </div>
                            </div>
                        </div>
                        <small class="text-muted">Có thể chọn nhiều người cùng lúc.</small>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-success fw-bold">
                        <span data-feather="send" style="width: 16px"></span> Giao việc ngay
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const modal = document.getElementById('createTaskModal');
        const listContainer = document.getElementById('userListContainer');
        const selectAllCheckbox = document.getElementById('selectAllUsers');
        const form = document.getElementById('createTaskForm');

        // Element checkbox tự giao việc
        const selfAssignCheck = document.getElementById('selfAssignCheck');

        // Các input thời gian
        const startDateInput = document.getElementById('startDateInput');
        const dueDateInput = document.getElementById('dueDateInput');

        // Cấu hình lặp lại
        const recurrenceSelect = document.getElementById('recurrenceSelect');
        const weeklyDaysContainer = document.getElementById('weeklyDaysContainer');
        const monthlyDayContainer = document.getElementById('monthlyDayContainer');

        function toggleRecurrenceOptions() {
            if (!recurrenceSelect) return;
            const val = recurrenceSelect.value;
            const weeklyCbs = document.querySelectorAll('#weeklyDaysContainer input[name="recurrence_days"]');
            const monthlyCbs = document.querySelectorAll('#monthlyDayContainer input[name="recurrence_days"]');
            
            if (val === 'weekly') {
                if (weeklyDaysContainer) weeklyDaysContainer.style.display = 'block';
                if (monthlyDayContainer) monthlyDayContainer.style.display = 'none';
                
                weeklyCbs.forEach(cb => cb.disabled = false);
                monthlyCbs.forEach(cb => cb.disabled = true);
                
                autoCheckStartDay();
            } else if (val === 'monthly') {
                if (weeklyDaysContainer) weeklyDaysContainer.style.display = 'none';
                if (monthlyDayContainer) monthlyDayContainer.style.display = 'block';
                
                weeklyCbs.forEach(cb => cb.disabled = true);
                monthlyCbs.forEach(cb => cb.disabled = false);
                
                autoCheckMonthlyDay();
            } else {
                if (weeklyDaysContainer) weeklyDaysContainer.style.display = 'none';
                if (monthlyDayContainer) monthlyDayContainer.style.display = 'none';
                
                weeklyCbs.forEach(cb => cb.disabled = true);
                monthlyCbs.forEach(cb => cb.disabled = true);
            }
        }

        function autoCheckStartDay() {
            if (startDateInput && startDateInput.value) {
                const date = new Date(startDateInput.value);
                const dayOfWeek = date.getDay(); // 0 = Sunday, 1 = Monday, ...
                document.querySelectorAll('#weeklyDaysContainer input[name="recurrence_days"]').forEach(cb => {
                    cb.checked = (parseInt(cb.value) === dayOfWeek);
                });
            }
        }

        function autoCheckMonthlyDay() {
            if (startDateInput && startDateInput.value) {
                const date = new Date(startDateInput.value);
                const dayOfMonth = date.getDate();
                document.querySelectorAll('#monthlyDayContainer input[name="recurrence_days"]').forEach(cb => {
                    cb.checked = (parseInt(cb.value) === dayOfMonth);
                });
            }
        }

        if (recurrenceSelect) {
            recurrenceSelect.addEventListener('change', toggleRecurrenceOptions);
        }
        if (startDateInput) {
            startDateInput.addEventListener('change', () => {
                if (recurrenceSelect) {
                    if (recurrenceSelect.value === 'weekly') {
                        autoCheckStartDay();
                    } else if (recurrenceSelect.value === 'monthly') {
                        autoCheckMonthlyDay();
                    }
                }
            });
        }

        let preSelectUserId = null;

        // --- XỬ LÝ MẪU CÔNG VIỆC CHUNG (TEMPLATE) ---
        const templateSelect = document.getElementById('templateSelect');
        const btnDeleteTemplate = document.getElementById('btnDeleteTemplate');
        const btnSaveAsTemplate = document.getElementById('btnSaveAsTemplate');

        let loadedTemplates = [];

        function loadTemplates(selectedId = null) {
            if (!templateSelect) return;
            fetch('/api/templates')
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        loadedTemplates = data.templates || [];
                        templateSelect.innerHTML = '<option value="">-- Chọn mẫu công việc nhanh (Hoặc tự nhập) --</option>';
                        loadedTemplates.forEach(t => {
                            const option = document.createElement('option');
                            option.value = t.id;
                            let scopeLabel = 'Cá nhân';
                            if (t.share_level === 'DEPARTMENT') scopeLabel = 'Khoa';
                            else if (t.share_level === 'GLOBAL') scopeLabel = 'Hệ thống';
                            option.textContent = `${t.name} [${scopeLabel}]`;
                            templateSelect.appendChild(option);
                        });
                        
                        if (selectedId) {
                            templateSelect.value = selectedId;
                            templateSelect.dispatchEvent(new Event('change'));
                        } else {
                            if (btnDeleteTemplate) btnDeleteTemplate.style.display = 'none';
                        }
                        if (typeof feather !== 'undefined') feather.replace();
                    }
                })
                .catch(err => console.error("Lỗi tải mẫu:", err));
        }

        if (templateSelect) {
            templateSelect.addEventListener('change', function () {
                const val = this.value;
                if (!val) {
                    if (btnDeleteTemplate) btnDeleteTemplate.style.display = 'none';
                    return;
                }

                const selected = loadedTemplates.find(t => String(t.id) === String(val));
                if (selected) {
                    const titleInput = form.querySelector('input[name="title"]');
                    const descInput = form.querySelector('textarea[name="description"]');
                    const priorityInput = form.querySelector('select[name="priority"]');
                    const tagsInput = form.querySelector('input[name="tags"]');

                    if (titleInput) titleInput.value = selected.title || '';
                    if (descInput) descInput.value = selected.description || '';
                    if (priorityInput) priorityInput.value = selected.priority || 'Trung bình';
                    if (tagsInput) tagsInput.value = selected.tags || '';

                    // Kiểm tra xem user hiện tại là người tạo hoặc admin để hiện nút xóa
                    const currentUserId = '<%= user.id %>';
                    const currentUserRole = '<%= user.role %>';
                    if (currentUserRole === 'ADMIN' || String(selected.created_by) === String(currentUserId)) {
                        if (btnDeleteTemplate) btnDeleteTemplate.style.display = 'block';
                    } else {
                        if (btnDeleteTemplate) btnDeleteTemplate.style.display = 'none';
                    }
                }
            });
        }

        if (btnSaveAsTemplate) {
            btnSaveAsTemplate.addEventListener('click', function () {
                const titleInput = form.querySelector('input[name="title"]');
                const descInput = form.querySelector('textarea[name="description"]');
                const priorityInput = form.querySelector('select[name="priority"]');
                const tagsInput = form.querySelector('input[name="tags"]');
                const templateNameInput = document.getElementById('templateNameInput');

                const titleVal = titleInput ? titleInput.value.trim() : '';
                if (!titleVal) {
                    showAlert('Cảnh báo', 'Vui lòng nhập Tiêu đề công việc trước khi lưu thành Mẫu!', 'warning');
                    if (titleInput) titleInput.focus();
                    return;
                }

                const templateName = templateNameInput ? templateNameInput.value.trim() : '';
                if (!templateName) {
                    showAlert('Cảnh báo', 'Vui lòng nhập tên gợi nhớ cho Mẫu công việc trước khi lưu!', 'warning');
                    if (templateNameInput) templateNameInput.focus();
                    return;
                }

                const shareLevelInput = document.querySelector('input[name="shareLevel"]:checked');
                const shareLevel = shareLevelInput ? shareLevelInput.value : 'PRIVATE';

                const bodyData = {
                    name: templateName,
                    title: titleVal,
                    description: descInput ? descInput.value.trim() : '',
                    priority: priorityInput ? priorityInput.value : 'Trung bình',
                    tags: tagsInput ? tagsInput.value.trim() : '',
                    share_level: shareLevel
                };

                fetch('/api/templates', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(bodyData)
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showAlert('Thành công', data.message || 'Lưu mẫu thành công!', 'success').then(() => {
                            if (templateNameInput) templateNameInput.value = '';
                            loadTemplates(data.template.id);
                        });
                    } else {
                        showAlert('Lỗi', data.message || 'Không thể lưu mẫu!', 'error');
                    }
                })
                .catch(err => {
                    console.error(err);
                    showAlert('Thất bại', 'Lỗi kết nối máy chủ!', 'error');
                });
            });
        }

        if (btnDeleteTemplate) {
            btnDeleteTemplate.addEventListener('click', function () {
                const val = templateSelect.value;
                if (!val) return;

                showConfirm('Xác nhận', 'Bạn có chắc chắn muốn xóa mẫu công việc này?').then(result => {
                    if (result.isConfirmed) {
                        fetch(`/api/templates/${val}`, { method: 'DELETE' })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                showAlert('Thành công', data.message || 'Đã xóa mẫu!', 'success').then(() => {
                                    loadTemplates();
                                });
                            } else {
                                showAlert('Lỗi', data.message || 'Không thể xóa mẫu!', 'error');
                            }
                        })
                        .catch(err => {
                            console.error(err);
                            showAlert('Thất bại', 'Lỗi kết nối máy chủ!', 'error');
                        });
                    }
                });
            });
        }

        // 1. KHI MỞ MODAL
        modal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;

            // Xóa dữ liệu copy nếu mở từ nút bình thường
            if (event && event.relatedTarget) {
                window.copyTaskData = null;
                window.copyTaskAssignedTo = null;
            }

            preSelectUserId = button ? button.getAttribute('data-preselect') : null;
            const isAutoSelf = button ? button.getAttribute('data-auto-self') === 'true' : false;

            // Reset trạng thái ban đầu
            if (selectAllCheckbox) {
                selectAllCheckbox.checked = false;
                selectAllCheckbox.disabled = false;
            }
            if (selfAssignCheck) {
                selfAssignCheck.checked = false;
            }
            listContainer.style.opacity = '1';
            listContainer.style.pointerEvents = 'auto';

            // Tải danh sách mẫu
            loadTemplates();

            // --- LOGIC TỰ ĐỘNG TICK "TÔI TỰ LÀM" ---
            if (isAutoSelf && selfAssignCheck) {
                selfAssignCheck.checked = true;
                selfAssignCheck.dispatchEvent(new Event('change'));
            }

            // Reset cấu hình lặp lại
            if (recurrenceSelect) {
                recurrenceSelect.value = 'none';
                recurrenceSelect.dispatchEvent(new Event('change'));
            }

            // --- LOGIC THỜI GIAN ---
            const now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            const currentDateTime = now.toISOString().slice(0, 19); // YYYY-MM-DDTHH:mm:ss

            // Tự nhập deadline là 23:59:59 today()
            const todayEnd = new Date();
            todayEnd.setHours(23, 59, 59, 999);
            const y = todayEnd.getFullYear();
            const m = String(todayEnd.getMonth() + 1).padStart(2, '0');
            const d = String(todayEnd.getDate()).padStart(2, '0');
            const h = String(todayEnd.getHours()).padStart(2, '0');
            const min = String(todayEnd.getMinutes()).padStart(2, '0');
            const defaultDueDate = `${y}-${m}-${d}T${h}:${min}:59`; // YYYY-MM-DDTHH:mm:ss

            if (startDateInput) {
                startDateInput.value = currentDateTime;
                startDateInput.min = currentDateTime;
            }
            if (dueDateInput) {
                dueDateInput.value = defaultDueDate;
                dueDateInput.min = currentDateTime;
            }

            // --- XỬ LÝ ĐIỀN THÔNG TIN SAO CHÉP (COPY) ---
            const titleInput = form.querySelector('input[name="title"]');
            const descInput = form.querySelector('textarea[name="description"]');
            const priorityInput = form.querySelector('select[name="priority"]');
            const tagsInput = form.querySelector('input[name="tags"]');

            if (window.copyTaskData) {
                const data = window.copyTaskData;
                if (titleInput) titleInput.value = data.title || '';
                if (descInput) descInput.value = data.description || '';
                if (priorityInput) priorityInput.value = data.priority || 'Trung bình';
                if (tagsInput) tagsInput.value = data.tags || '';

                const currentUserId = '<%= user.id %>';
                const assigneeIds = data.assignedTo || [];
                const isSelf = assigneeIds.map(String).includes(String(currentUserId));

                if (isSelf && selfAssignCheck) {
                    selfAssignCheck.checked = true;
                    selfAssignCheck.dispatchEvent(new Event('change'));
                } else if (selfAssignCheck) {
                    selfAssignCheck.checked = false;
                    selfAssignCheck.dispatchEvent(new Event('change'));
                }

                window.copyTaskAssignedTo = assigneeIds;
            } else {
                if (titleInput && !isAutoSelf) titleInput.value = '';
                if (descInput && !isAutoSelf) descInput.value = '';
                if (priorityInput && !isAutoSelf) priorityInput.value = 'Trung bình';
                if (tagsInput && !isAutoSelf) tagsInput.value = '';
                window.copyTaskAssignedTo = null;
            }

            loadUsers();
        });

        // 2. XỬ LÝ KHI CHỌN "TÔI TỰ LÀM"
        if (selfAssignCheck) {
            selfAssignCheck.addEventListener('change', function () {
                // Giữ nguyên danh sách người nhận việc mở để cho phép chọn thêm cấp dưới
            });
        }
        const selfAssignBox = document.querySelector('.self-assign-box');
        if (selfAssignBox && selfAssignCheck) {
            selfAssignBox.addEventListener('click', function(e) {
                if (e.target.tagName !== 'INPUT' && e.target.tagName !== 'LABEL' && e.target.tagName !== 'SPAN' && e.target.tagName !== 'svg' && e.target.tagName !== 'path') {
                    selfAssignCheck.checked = !selfAssignCheck.checked;
                    selfAssignCheck.dispatchEvent(new Event('change'));
                }
            });
        }

        // 3. HÀM LOAD USER
        function loadUsers() {
            listContainer.innerHTML = '<div class="text-center text-muted py-3"><div class="spinner-border spinner-border-sm"></div> Đang tải...</div>';

            fetch('/api/users/subordinates')
                .then(res => res.json())
                .then(data => {
                    listContainer.innerHTML = '';

                    if (data.users && data.users.length > 0) {
                        data.users.forEach(u => {
                            const disabledAttr = '';

                            // Check nếu thuộc danh sách được chọn (bao gồm trường hợp copy hoặc pre-select)
                            let isChecked = false;
                            if (preSelectUserId && String(preSelectUserId) === String(u.id)) {
                                isChecked = true;
                            } else if (window.copyTaskAssignedTo && window.copyTaskAssignedTo.map(String).includes(String(u.id))) {
                                isChecked = true;
                            }

                            const checkedAttr = isChecked ? 'checked' : '';
                            const bgClass = isChecked ? 'user-row-selected' : '';

                            const div = document.createElement('div');
                            div.className = `d-flex align-items-center mb-1 p-2 border rounded user-row-item ${bgClass}`;
                            div.style.cursor = 'pointer';

                            div.innerHTML = `
                                <div class="me-2">
                                    <input class="form-check-input user-checkbox" type="checkbox" 
                                           name="assigned_to" value="${u.id}" id="user_${u.id}" ${checkedAttr} ${disabledAttr}
                                           style="width: 1.2em; height: 1.2em; cursor: pointer;">
                                </div>
                                <label class="flex-grow-1 mb-0" style="cursor:pointer; user-select: none;" for="user_${u.id}">
                                    <strong>${u.fullname}</strong> 
                                    <span class="badge bg-secondary ms-1" style="font-size: 0.7em">${u.role}</span>
                                </label>
                            `;

                            // Toggle checkbox when clicking anywhere on the row (excluding elements that already handle click natively)
                            div.addEventListener('click', function(e) {
                                if (e.target.tagName !== 'INPUT' && e.target.tagName !== 'LABEL') {
                                    const cb = div.querySelector('.user-checkbox');
                                    cb.checked = !cb.checked;
                                    cb.dispatchEvent(new Event('change'));
                                }
                            });

                            // Dynamic highlight background when checked/unchecked
                            const cb = div.querySelector('.user-checkbox');
                            cb.addEventListener('change', function() {
                                if (this.checked) {
                                    div.classList.add('user-row-selected');
                                } else {
                                    div.classList.remove('user-row-selected');
                                }
                            });

                            listContainer.appendChild(div);
                        });
                        if (typeof feather !== 'undefined') feather.replace();
                    } else {
                        listContainer.innerHTML = '<p class="text-muted text-center mb-0 small">Bạn chưa có nhân viên cấp dưới.</p>';
                    }
                })
                .catch(err => {
                    console.error(err);
                    listContainer.innerHTML = '<p class="text-danger text-center">Lỗi tải dữ liệu.</p>';
                });
        }

        // 4. XỬ LÝ CHỌN TẤT CẢ
        if (selectAllCheckbox) {
            selectAllCheckbox.addEventListener('change', function () {
                const checkboxes = document.querySelectorAll('.user-checkbox');
                checkboxes.forEach(cb => cb.checked = this.checked);
            });
        }

        // 5. XỬ LÝ SUBMIT BẰNG AJAX
        if (form) {
            form.addEventListener('submit', async function (e) {
                e.preventDefault();

                const btnSubmit = form.querySelector('button[type="submit"]');
                const originalBtnText = btnSubmit.innerHTML;

                const isSelf = selfAssignCheck ? selfAssignCheck.checked : false;
                const checked = document.querySelectorAll('.user-checkbox:checked');

                if (!isSelf && checked.length === 0) {
                    showAlert('Cảnh báo', 'Vui lòng chọn ít nhất một người nhận việc (hoặc chọn "Tôi tự thực hiện")!', 'warning');
                    const target = document.querySelector('.card.p-2');
                    if (target) {
                        target.scrollIntoView({ behavior: 'smooth' });
                        target.classList.add('border', 'border-danger');
                        setTimeout(() => target.classList.remove('border-danger'), 2000);
                    }
                    return;
                }

                try {
                    btnSubmit.disabled = true;
                    btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang xử lý...';

                    const formData = new FormData(this);

                    const response = await fetch('/api/tasks', {
                        method: 'POST',
                        body: formData
                    });

                    const result = await response.json();

                    if (result.success) {
                        showAlert('Thành công', result.message || 'Giao việc thành công!', 'success').then(() => {
                            window.location.reload();
                        });
                    } else {
                        showAlert('Lỗi', result.message || 'Có lỗi xảy ra!', 'error');
                    }

                } catch (err) {
                    console.error(err);
                    showAlert('Thất bại', 'Lỗi kết nối đến máy chủ!', 'error');
                } finally {
                    btnSubmit.disabled = false;
                    btnSubmit.innerHTML = originalBtnText;
                }
            });
        }
    });
</script>